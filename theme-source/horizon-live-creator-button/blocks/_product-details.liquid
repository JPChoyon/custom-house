<script>
  (function () {
    const productInfo = document.getElementById('ProductInformation-{{ section.id }}');

    if (!productInfo || productInfo.dataset.markedProductReady === 'true') return;

    productInfo.dataset.markedProductReady = 'true';

    const productActions = productInfo.querySelector('[data-marked-product-actions]');
    const productForm = productInfo.querySelector('.marked-product-form');
    const quantityInput = productInfo.querySelector('.marked-product-actions__qty-input');
    const addButton = productInfo.querySelector('[data-add-to-cart-button]');
    const addButtonLabel = productInfo.querySelector('[data-add-to-cart-label]');
    const cartStatus = productInfo.querySelector('[data-cart-status]');
    const forceAllowPurchase = Boolean(
      productActions && productActions.dataset.forceAllowPurchase === 'true'
    );
    const isInkyBayDesignerProduct = Boolean(
      productActions && productActions.dataset.inkybayDesignerProduct === 'true'
    );
    const inkybayScriptSource = 'https://inkybay.com/shopify/js/inkybay.js?shop={{ shop.permanent_domain | escape }}';
    const sectionRoot = document.getElementById('PremiumTruckerProduct-{{ section.id }}');
    const nativeHost = productInfo.querySelector('[data-inkybay-native-host]');
    const customizeStatus = productInfo.querySelector('[data-inkybay-customize-status]');
    let nativeButtonObserver = null;

    function setCustomizeStatus(message, isError) {
      if (!customizeStatus) return;

      customizeStatus.textContent = message || '';
      customizeStatus.classList.toggle('is-error', Boolean(isError));
      customizeStatus.hidden = !message;
    }

    function ensureInkybayScript() {
      if (window.__markedInkybayScriptPromise) {
        return window.__markedInkybayScriptPromise;
      }

      window.__markedInkybayScriptPromise = new Promise(function (resolve) {
        let finished = false;
        let script = Array.from(document.scripts).find(function (item) {
          return String(item.src || '').includes('inkybay.com/shopify/js/inkybay.js');
        });

        function finish() {
          if (finished) return;
          finished = true;
          resolve();
        }

        function pollForApi(attempt) {
          if (typeof window.showProductsDesigner === 'function' || findInkybayCustomizeButton()) {
            finish();
            return;
          }

          if (attempt >= 80) {
            finish();
            return;
          }

          window.setTimeout(function () {
            pollForApi(attempt + 1);
          }, 125);
        }

        if (!script) {
          script = document.createElement('script');
          script.src = inkybayScriptSource;
          script.async = true;
          script.dataset.markedInkybayLoader = 'true';
          document.head.appendChild(script);
        }

        script.addEventListener('load', function () {
          pollForApi(0);
        }, { once: true });
        script.addEventListener('error', finish, { once: true });

        pollForApi(0);
        window.setTimeout(finish, 12000);
      });

      return window.__markedInkybayScriptPromise;
    }

    function closeSizeGuide() {
      const modal = productInfo.querySelector('[data-size-guide-modal]');

      if (!modal) return;

      modal.hidden = true;
      modal.setAttribute('aria-hidden', 'true');
    }

    function findInkybayCustomizeButton() {
      const exactSelectors = [
        '#EFOLI_CUSTOMIZE_IT_BUTTON',
        '[data-inkybay-customize-button]',
        '.efoli-customize-it-button',
        '[onclick*="showProductsDesigner"]',
        '[onmouseup*="showProductsDesigner"]',
        '[href*="showProductsDesigner"]'
      ].join(', ');

      const localButton = nativeHost && nativeHost.querySelector(exactSelectors);
      if (localButton) return localButton;

      return Array.from(document.querySelectorAll(exactSelectors)).find(function (element) {
        return !element.matches('[data-inkybay-customize-trigger]');
      }) || null;
    }

    function prepareNativeInkybayButton() {
      const nativeButton = findInkybayCustomizeButton();

      if (!nativeButton) {
        return null;
      }

      if (nativeButton.tagName === 'BUTTON') {
        nativeButton.type = 'button';
      }

      if (nativeButton.tagName === 'INPUT' && String(nativeButton.type).toLowerCase() === 'submit') {
        nativeButton.type = 'button';
      }

      nativeButton.setAttribute('aria-label', 'Customize this product');
      nativeButton.setAttribute('tabindex', '-1');

      setCustomizeStatus('', false);
      return nativeButton;
    }

    function watchForNativeInkybayButton() {
      prepareNativeInkybayButton();

      if (nativeButtonObserver) return;

      nativeButtonObserver = new MutationObserver(function () {
        prepareNativeInkybayButton();
      });

      nativeButtonObserver.observe(document.body, {
        childList: true,
        subtree: true,
        attributes: true,
        attributeFilter: ['id', 'class', 'href', 'onclick', 'onmouseup']
      });
    }

    function syncInkybaySizeAndQuantity() {
      const nativeHost = productInfo.querySelector('#EFOLI_DESIGNER_CUSTOMIZE_IT_BUTTON_PLACE');
      const nativeQuantityInputs = nativeHost
        ? Array.from(nativeHost.querySelectorAll('input.efl_size_qty_box'))
        : Array.from(document.querySelectorAll('input.efl_size_qty_box'));

      if (!nativeQuantityInputs.length) return;

      const selectedSizeButton = productInfo.querySelector('[data-size-option-value].is-active');
      const selectedSize = selectedSizeButton
        ? String(selectedSizeButton.dataset.sizeOptionValue || '').trim().toLowerCase()
        : '';
      const quantity = Math.max(Number.parseInt(quantityInput && quantityInput.value, 10) || 1, 1);

      let matchingInput = nativeQuantityInputs.find(function (input) {
        const inputName = String(input.name || '');
        const inputSize = inputName.split(':').pop().trim().toLowerCase();

        return selectedSize && inputSize === selectedSize;
      });

      if (!matchingInput) matchingInput = nativeQuantityInputs[0];

      nativeQuantityInputs.forEach(function (input) {
        input.value = '0';
        input.setAttribute('value', '0');
        input.setAttribute('altvalue', '0');
      });

      matchingInput.value = String(quantity);
      matchingInput.setAttribute('value', String(quantity));
      matchingInput.setAttribute('altvalue', String(quantity));
      matchingInput.dispatchEvent(new Event('input', { bubbles: true }));
      matchingInput.dispatchEvent(new Event('change', { bubbles: true }));
      matchingInput.dispatchEvent(new Event('keyup', { bubbles: true }));
      matchingInput.dispatchEvent(new Event('blur', { bubbles: true }));
    }

    function launchNativeInkybayButton(nativeButton) {
      if (!nativeButton) return false;

      syncInkybaySizeAndQuantity();

      const inlineMouseUp = nativeButton.onmouseup;
      const inlineClick = nativeButton.onclick;

      try {
        if (typeof inlineMouseUp === 'function') {
          inlineMouseUp.call(nativeButton, new MouseEvent('mouseup', {
            bubbles: true,
            cancelable: true,
            view: window
          }));
          return true;
        }

        if (typeof inlineClick === 'function') {
          inlineClick.call(nativeButton, new MouseEvent('click', {
            bubbles: true,
            cancelable: true,
            view: window
          }));
          return true;
        }

        if (typeof window.showProductsDesigner === 'function') {
          window.showProductsDesigner(nativeButton);
          return true;
        }

        nativeButton.dispatchEvent(new MouseEvent('mousedown', {
          bubbles: true,
          cancelable: true,
          view: window
        }));
        nativeButton.dispatchEvent(new MouseEvent('mouseup', {
          bubbles: true,
          cancelable: true,
          view: window
        }));
        nativeButton.dispatchEvent(new MouseEvent('click', {
          bubbles: true,
          cancelable: true,
          view: window
        }));

        const nativeHref = nativeButton.getAttribute('href');
        if (nativeHref && nativeHref !== '#' && !nativeHref.toLowerCase().startsWith('javascript:')) {
          window.location.assign(nativeHref);
        }

        return true;
      } catch (error) {
        console.error('InkyBay launch error:', error);
        return false;
      }
    }

    function waitForNativeInkybayButton(timeoutMs) {
      return new Promise(function (resolve) {
        const startedAt = Date.now();

        function check() {
          const nativeButton = prepareNativeInkybayButton();

          if (nativeButton) {
            resolve(nativeButton);
            return;
          }

          if (Date.now() - startedAt >= timeoutMs) {
            resolve(null);
            return;
          }

          window.setTimeout(check, 150);
        }

        check();
      });
    }

    async function openInkybayCustomizer(customButton) {
      customButton.setAttribute('aria-busy', 'true');
      customButton.classList.add('is-loading');
      setCustomizeStatus('Loading the product customizer…', false);

      await ensureInkybayScript();
      watchForNativeInkybayButton();

      const nativeButton = await waitForNativeInkybayButton(15000);

      customButton.removeAttribute('aria-busy');
      customButton.classList.remove('is-loading');

      if (!nativeButton) {
        setCustomizeStatus(
          'The InkyBay button did not load. Enable the InkyBay app embed and confirm that this product is configured as a Custom Product in InkyBay.',
          true
        );
        return;
      }

      setCustomizeStatus('', false);
      launchNativeInkybayButton(nativeButton);
    }

    function setControlValue(control, value) {
      if (!control) return;

      control.value = String(value);
      control.setAttribute('value', String(value));
      control.dispatchEvent(new Event('input', { bubbles: true }));
      control.dispatchEvent(new Event('change', { bubbles: true }));
    }

    function setCartStatus(message, isError) {
      if (!cartStatus) return;

      cartStatus.textContent = message || '';
      cartStatus.classList.toggle('is-error', Boolean(isError));
      cartStatus.hidden = !message;
    }

    function getVariants(actions) {
      if (!actions) return [];

      try {
        return JSON.parse(actions.dataset.productVariants || '[]');
      } catch (error) {
        return [];
      }
    }

    function getCurrentVariant(actions) {
      const variants = getVariants(actions);
      const variantInput = actions && actions.querySelector('.marked-product-form [name="id"]');
      const variantId = variantInput ? String(variantInput.value || '') : '';

      return variants.find(function (variant) {
        return String(variant.id) === variantId;
      }) || null;
    }

    function updatePurchaseState(selectedVariant) {
      const hasVariant = Boolean(selectedVariant && selectedVariant.id);
      const canAttemptPurchase = hasVariant && (
        forceAllowPurchase || selectedVariant.available
      );

      const variantInput = productForm && productForm.querySelector('[name="id"]');

      if (variantInput) {
        variantInput.disabled = !canAttemptPurchase;
      }

      if (addButton) {
        addButton.disabled = !canAttemptPurchase;
      }

      if (addButtonLabel) {
        addButtonLabel.textContent = canAttemptPurchase ? 'Add to cart' : 'Sold out';
      }
    }

    async function addCurrentVariantToCart() {
      if (!productForm || !addButton) return;

      const variantInput = productForm.querySelector('[name="id"]');
      const variantId = Number.parseInt(variantInput && variantInput.value, 10);
      const quantity = Math.max(
        Number.parseInt(quantityInput && quantityInput.value, 10) || 1,
        1
      );

      if (!variantId) {
        setCartStatus('Please select a valid product option.', true);
        return;
      }

      addButton.disabled = true;
      addButton.setAttribute('aria-busy', 'true');
      setCartStatus('Adding your product to the cart…', false);

      try {
        const cartAddUrl = window.Shopify?.routes?.root
          ? window.Shopify.routes.root + 'cart/add.js'
          : '/cart/add.js';

        const response = await fetch(cartAddUrl, {
          method: 'POST',
          headers: {
            'Accept': 'application/json',
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({
            items: [
              {
                id: variantId,
                quantity: quantity
              }
            ]
          })
        });

        const payload = await response.json().catch(function () {
          return {};
        });

        if (!response.ok) {
          throw new Error(
            payload.description ||
            payload.message ||
            'Shopify did not allow this variant to be added.'
          );
        }

        setCartStatus('Added to cart. Redirecting…', false);
        window.location.assign('/cart');
      } catch (error) {
        setCartStatus(
          error && error.message
            ? error.message
            : 'This variant could not be added. Check Shopify overselling and market availability.',
          true
        );
        updatePurchaseState(getCurrentVariant(productActions));
      } finally {
        addButton.removeAttribute('aria-busy');
        updatePurchaseState(getCurrentVariant(productActions));
      }
    }

    function syncSelectedVariant(selectedVariant, dispatchVariantEvents) {
      if (!selectedVariant) return;

      const variantId = String(selectedVariant.id);
      const variantControls = Array.from(
        productInfo.querySelectorAll('form[action*="/cart/add"] [name="id"], .marked-product-form [name="id"]')
      );

      variantControls.forEach(function (control) {
        if (control.tagName === 'SELECT') {
          const hasVariant = Array.from(control.options || []).some(function (option) {
            return String(option.value) === variantId;
          });

          if (!hasVariant) return;
        }

        control.disabled = !(forceAllowPurchase || selectedVariant.available);
        setControlValue(control, variantId);
      });

      updatePurchaseState(selectedVariant);
      setCartStatus('', false);

      try {
        const nextUrl = new URL(window.location.href);
        nextUrl.searchParams.set('variant', variantId);
        window.history.replaceState({}, '', nextUrl.toString());
      } catch (error) {
        // URL synchronization is optional.
      }

      if (dispatchVariantEvents !== false) {
        const detail = {
          variant: selectedVariant,
          source: 'marked-product-actions'
        };
        productInfo.dispatchEvent(new CustomEvent('variant:change', { bubbles: true, detail: detail }));
        document.dispatchEvent(new CustomEvent('variant:change', { detail: detail }));
      }
    }

    function getVariantForSize(actions, selectedValue) {
      const sizeOptionIndex = Math.max(
        Number.parseInt(actions.dataset.sizeOptionPosition, 10) || 1,
        1
      ) - 1;
      const variants = getVariants(actions);

      const currentVariantInput = actions.querySelector('input[name="id"]');
      const currentVariantId = currentVariantInput ? String(currentVariantInput.value || '') : '';
      const currentVariant = variants.find(function (variant) {
        return String(variant.id) === currentVariantId;
      });

      if (currentVariant && Array.isArray(currentVariant.options)) {
        const desiredOptions = currentVariant.options.slice();
        desiredOptions[sizeOptionIndex] = selectedValue;

        const exactVariant = variants.find(function (variant) {
          return Array.isArray(variant.options) && variant.options.every(function (value, index) {
            return String(value) === String(desiredOptions[index]);
          });
        });

        if (exactVariant) return exactVariant;
      }

      const matchingVariants = variants.filter(function (variant) {
        return Array.isArray(variant.options) && String(variant.options[sizeOptionIndex]) === String(selectedValue);
      });

      return matchingVariants.find(function (variant) {
        return variant.available;
      }) || matchingVariants[0] || null;
    }

    if (productForm && forceAllowPurchase) {
      productForm.addEventListener('submit', function (event) {
        event.preventDefault();
        addCurrentVariantToCart();
      });
    }

    document.addEventListener('variant:change', function (event) {
      const variant = event.detail && event.detail.variant;
      const source = event.detail && event.detail.source;

      if (!variant || source === 'marked-product-actions') return;

      const variants = getVariants(productActions);
      const localVariant = variants.find(function (item) {
        return String(item.id) === String(variant.id);
      });

      if (localVariant) {
        syncSelectedVariant(localVariant, false);
      }
    });

    productInfo.addEventListener('change', function (event) {
      const target = event.target;

      if (!target || target.closest('.marked-product-form')) return;
      if (!target.matches('input[type="radio"], select')) return;

      window.setTimeout(function () {
        const variants = getVariants(productActions);
        const urlVariantId = new URL(window.location.href).searchParams.get('variant');
        const nativeVariantControl = Array.from(
          productInfo.querySelectorAll('form[action*="/cart/add"] [name="id"]')
        ).find(function (control) {
          return !control.closest('.marked-product-form') && control.value;
        });
        const variantId = urlVariantId || (nativeVariantControl && nativeVariantControl.value);
        const variant = variants.find(function (item) {
          return String(item.id) === String(variantId || '');
        });

        if (variant) {
          syncSelectedVariant(variant, false);
        }
      }, 80);
    });

    updatePurchaseState(getCurrentVariant(productActions));
    if (isInkyBayDesignerProduct) {
      watchForNativeInkybayButton();
      ensureInkybayScript().then(function () {
        watchForNativeInkybayButton();
        prepareNativeInkybayButton();
      });
    }

    document.addEventListener('click', function (event) {
      const customizeButton = event.target.closest('[data-inkybay-customize-trigger]');

      const isSectionCustomizeButton = Boolean(
        customizeButton &&
        (productInfo.contains(customizeButton) || (sectionRoot && sectionRoot.contains(customizeButton)))
      );

      if (isSectionCustomizeButton) {
        event.preventDefault();
        event.stopPropagation();

        if (customizeButton.getAttribute('aria-busy') === 'true') return;

        openInkybayCustomizer(customizeButton);
        return;
      }

      const quantityButton = event.target.closest('[data-quantity-minus], [data-quantity-plus]');

      if (quantityButton && productInfo.contains(quantityButton)) {
        const actions = quantityButton.closest('[data-marked-product-actions]');
        const input = actions && actions.querySelector('.marked-product-actions__qty-input');

        if (!input) return;

        const currentValue = Number.parseInt(input.value, 10) || 1;
        const nextValue = quantityButton.hasAttribute('data-quantity-plus')
          ? currentValue + 1
          : Math.max(1, currentValue - 1);

        input.value = String(nextValue);
        input.dispatchEvent(new Event('input', { bubbles: true }));
        input.dispatchEvent(new Event('change', { bubbles: true }));
        return;
      }

      const sizeButton = event.target.closest('[data-size-option-value]');

      if (sizeButton && productInfo.contains(sizeButton)) {
        const actions = sizeButton.closest('[data-marked-product-actions]');

        if (!actions) return;

        const selectedValue = sizeButton.dataset.sizeOptionValue;
        const selectedVariant = getVariantForSize(actions, selectedValue);

        actions.querySelectorAll('[data-size-option-value]').forEach(function (button) {
          const isSelected = button === sizeButton;
          button.classList.toggle('is-active', isSelected);
          button.setAttribute('aria-pressed', isSelected ? 'true' : 'false');
        });

        if (selectedVariant) {
          syncSelectedVariant(selectedVariant);
        } else {
          updatePurchaseState(null);
          setCartStatus('This size does not have a matching Shopify variant.', true);
        }

        return;
      }

      const guideOpenButton = event.target.closest('[data-size-guide-open]');

      if (guideOpenButton && productInfo.contains(guideOpenButton)) {
        const modal = productInfo.querySelector('[data-size-guide-modal]');

        if (!modal) return;

        modal.hidden = false;
        modal.setAttribute('aria-hidden', 'false');
        const closeButton = modal.querySelector('[data-size-guide-close]');

        if (closeButton) closeButton.focus();
        return;
      }

      const guideCloseButton = event.target.closest('[data-size-guide-close]');

      if (guideCloseButton && productInfo.contains(guideCloseButton)) {
        closeSizeGuide();
      }
    });

    document.addEventListener('keydown', function (event) {
      if (event.key === 'Escape') closeSizeGuide();
    });
  })();
</script>

