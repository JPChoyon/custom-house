{%- assign block_settings = block.settings -%}
<div
  id="ProductInformation-{{ section.id }}"
  class="
    product-details
    {% if block_settings.sticky_details_desktop %} sticky-content--desktop{% endif %}
    {% if block_settings.height == 'fill' -%} full-height--desktop{% endif -%}
  "
  style="--details-position: {{ block_settings.details_position }};"
  data-testid="product-information-details"
  {% if settings.transition_to_main_product %}
    data-view-transition-type="product-details"
  {% endif %}
>
  {% capture children %}
    <div class="view-product-title">
      <a
        href="{{ closest.product.selected_or_first_available_variant.url }}"
      >
        {{- closest.product.title }}
      </a>
    </div>
    {% content_for 'blocks' %}

    {%- liquid
      assign product = closest.product
      assign selected_variant = product.selected_or_first_available_variant | default: product.variants.first
      assign product_form_id = 'MarkedProductForm-' | append: section.id
      assign force_allow_purchase = section.settings.force_allow_purchase
      assign size_option = blank
      assign size_option_name = 'Size'
      assign size_option_position = 1
      assign selected_size_value = selected_variant.option1
      assign customhouse_product_type = product.metafields.customhouse.product_type.value | downcase
      assign customhouse_inkybay_enabled = product.metafields.customhouse.inkybay_enabled.value
      assign is_creator_fixed_product = false
      assign is_inkybay_designer_product = false

      if customhouse_product_type == 'creator_fixed' or product.tags contains 'creator-fixed'
        assign is_creator_fixed_product = true
      endif

      unless is_creator_fixed_product
        if customhouse_product_type == 'global_customizable' and customhouse_inkybay_enabled == true
          assign is_inkybay_designer_product = true
        elsif product.tags contains 'inkybay-designlab' or product.tags contains 'inkybay-options'
          assign is_inkybay_designer_product = true
        endif
      endunless

      for option in product.options_with_values
        assign option_name = option.name | downcase
        if option_name contains 'size'
          assign size_option = option
          assign size_option_name = option.name
          assign size_option_position = option.position
          break
        endif
      endfor

      case size_option_position
        when 2
          assign selected_size_value = selected_variant.option2
        when 3
          assign selected_size_value = selected_variant.option3
        else
          assign selected_size_value = selected_variant.option1
      endcase

    -%}

    <div
      class="marked-product-actions"
      data-marked-product-actions
      data-product-variants="{{ product.variants | json | escape }}"
      data-size-option-position="{{ size_option_position }}"
      data-inkybay-designer-product="{% if is_inkybay_designer_product %}true{% else %}false{% endif %}"
      data-product-id="{{ product.id }}"
      data-product-handle="{{ product.handle | escape }}"
      data-force-allow-purchase="{% if force_allow_purchase %}true{% else %}false{% endif %}"
    >
      <div class="marked-product-actions__block marked-product-actions__block--size">
        <div class="marked-product-actions__size-row">
          <div class="marked-product-actions__size-content">
            <div class="marked-product-actions__size-header">
              <p class="marked-product-actions__label">{{ size_option_name }}:</p>
              <button class="marked-product-actions__guide" type="button" data-size-guide-open>
                <span aria-hidden="true">&#9776;</span>
                Size Guide
              </button>
            </div>
            <div class="marked-product-actions__pills" aria-label="{{ size_option_name }}">
              {%- if size_option != blank -%}
                {%- for value in size_option.values -%}
                  <button
                    class="marked-product-actions__pill{% if value == selected_size_value %} is-active{% endif %}"
                    type="button"
                    data-size-option-value="{{ value | escape }}"
                    aria-pressed="{% if value == selected_size_value %}true{% else %}false{% endif %}"
                  >
                    {{ value }}
                  </button>
                {%- endfor -%}
              {%- else -%}
                <button class="marked-product-actions__pill is-active" type="button" aria-pressed="true">One Size</button>
              {%- endif -%}
            </div>
          </div>
        </div>
      </div>

      {% form 'product', product, id: product_form_id, class: 'marked-product-form', novalidate: 'novalidate' %}
        <input
          type="hidden"
          name="id"
          value="{{ selected_variant.id }}"
          {% if force_allow_purchase == false and selected_variant.available == false %}
            disabled
          {% endif %}
        >

        <div class="marked-product-actions__block marked-product-actions__block--quantity">
          <label class="marked-product-actions__label" for="Quantity-{{ section.id }}">Quantity:</label>
          <div class="marked-product-actions__quantity">
            <button class="marked-product-actions__qty-button" type="button" data-quantity-minus aria-label="Decrease quantity">&minus;</button>
            <input
              id="Quantity-{{ section.id }}"
              class="marked-product-actions__qty-input"
              type="number"
              name="quantity"
              value="1"
              min="1"
              inputmode="numeric"
            >
            <button class="marked-product-actions__qty-button" type="button" data-quantity-plus aria-label="Increase quantity">+</button>
          </div>
        </div>

        {% if is_inkybay_designer_product %}
        <div class="marked-product-actions__block marked-product-actions__block--customize">
          <button
            class="marked-product-actions__customize"
            type="button"
            data-inkybay-customize-trigger
            data-product-id="{{ product.id }}"
            data-variant-id="{{ selected_variant.id }}"
            aria-label="Customize {{ product.title | escape }}"
          >
            <span aria-hidden="true">&#9998;</span>
            <span>Customize this product</span>
            <span aria-hidden="true">&rarr;</span>
          </button>

          {%- comment -%}
            InkyBay still creates its native product-specific button in this hidden
            host. The visible branded button above directly launches that native
            functionality through JavaScript; no invisible overlay is used.
          {%- endcomment -%}
          <div
            id="EFOLI_DESIGNER_CUSTOMIZE_IT_BUTTON_PLACE"
            class="marked-product-actions__inkybay-host"
            data-inkybay-native-host
            aria-hidden="true"
          ></div>

          <p
            class="marked-product-actions__customize-status"
            data-inkybay-customize-status
            role="status"
            aria-live="polite"
            hidden
          ></p>
        </div>
        {% endif %}

        <div class="marked-product-actions__block marked-product-actions__block--add">
          <button
            class="marked-product-actions__add"
            type="submit"
            name="add"
            data-add-to-cart-button
            {% if force_allow_purchase == false and selected_variant.available == false %}
              disabled
            {% endif %}
          >
            <span aria-hidden="true">&#128722;</span>
            <span data-add-to-cart-label>
              {%- if selected_variant.available or force_allow_purchase -%}
                Add to cart
              {%- else -%}
                Sold out
              {%- endif -%}
            </span>
          </button>
          <p class="marked-product-actions__cart-status" data-cart-status role="status" aria-live="polite" hidden></p>
        </div>

        <div class="marked-product-actions__block marked-product-actions__block--buy-now">
          <div class="marked-product-actions__buy-now">
            {{ form | payment_button }}
          </div>
        </div>
      {% endform %}


    </div>

    <div
      id="MarkedSizeGuide-{{ section.id }}"
      class="marked-size-guide-modal"
      data-size-guide-modal
      aria-hidden="true"
      hidden
    >
      <div class="marked-size-guide-modal__backdrop" data-size-guide-close></div>
      <div class="marked-size-guide-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="MarkedSizeGuideTitle-{{ section.id }}">
        <div class="marked-size-guide-modal__header">
          <h2 id="MarkedSizeGuideTitle-{{ section.id }}">Size Guide</h2>
          <button class="marked-size-guide-modal__close" type="button" data-size-guide-close aria-label="Close size guide">&times;</button>
        </div>
        <div class="marked-size-guide-modal__body">
          <p>Approximate body measurements in inches.</p>
          <div class="marked-size-guide-modal__table-wrap">
            <table class="marked-size-guide-modal__table">
              <thead>
                <tr>
                  <th>Size</th>
                  <th>Chest</th>
                  <th>Length</th>
                  <th>Shoulder</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td>S</td>
                  <td>36-38</td>
                  <td>27</td>
                  <td>16.5</td>
                </tr>
                <tr>
                  <td>M</td>
                  <td>38-40</td>
                  <td>28</td>
                  <td>17</td>
                </tr>
                <tr>
                  <td>L</td>
                  <td>40-42</td>
                  <td>29</td>
                  <td>17.5</td>
                </tr>
                <tr>
                  <td>XL</td>
                  <td>42-44</td>
                  <td>30</td>
                  <td>18</td>
                </tr>
                <tr>
                  <td>2XL</td>
                  <td>44-46</td>
                  <td>31</td>
                  <td>18.5</td>
                </tr>
                <tr>
                  <td>3XL</td>
                  <td>46-48</td>
                  <td>32</td>
                  <td>19</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  {% endcapture %}

  {% render 'group',
    children: children,
    settings: block_settings,
    shopify_attributes: block.shopify_attributes,
    background_color: block_settings.background_color,
    block_id: block.id
  %}
</div>

