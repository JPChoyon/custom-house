    </div>
  {% endif %}
</div>

{% if is_pitchprint_required_product %}
  <script src="{{ 'customhouse-pitchprint-order-handoff.js' | asset_url }}" defer></script>
  <script>
    (() => {
      if (window.__customHouseMobilePitchPrintTriggerBound) return;
      window.__customHouseMobilePitchPrintTriggerBound = true;

      const openDesigner = (button, root) => {
        const client = window.ppclient;

        if (!client || typeof client.showApp !== 'function') {
          return false;
        }

        client.showApp();
        button.removeAttribute('aria-busy');
        button.classList.remove('is-loading');

        const status = root.querySelector('[data-cart-status]');
        if (status) {
          status.textContent = '';
          status.hidden = true;
          status.classList.remove('is-error');
        }

        return true;
      };

      document.addEventListener('click', (event) => {
        const target = event.target instanceof Element ? event.target : null;
        if (!target) return;

        const button = target.closest('[data-mobile-pitchprint-customize-trigger]');
        if (!button) return;

        const root = button.closest('[data-customhouse-pitchprint-required="true"]');
        if (!root) return;

        event.preventDefault();

        if (button.getAttribute('aria-busy') === 'true') return;

        button.setAttribute('aria-busy', 'true');
        button.classList.add('is-loading');

        if (openDesigner(button, root)) return;

        requestAnimationFrame(() => {
          if (openDesigner(button, root)) return;

          window.setTimeout(() => {
            if (openDesigner(button, root)) return;

            button.removeAttribute('aria-busy');
            button.classList.remove('is-loading');

            const status = root.querySelector('[data-cart-status]');
            if (status) {
              status.textContent = 'The designer is still loading. Please try again.';
              status.hidden = false;
              status.classList.add('is-error');
            }

            console.warn('[CustomHouse PitchPrint] Mobile designer client unavailable');
          }, 150);
        });
      });
    })();
  </script>
{% endif %}

{% if section.settings.enable_custom_gallery or section.settings.enable_premium_style %}
  <script>
    (() => {
      const initPremiumGallery = (root = document) => {
        root.querySelectorAll('[data-premium-gallery]').forEach((gallery) => {
          if (gallery.dataset.premiumGalleryReady === 'true') return;
          gallery.dataset.premiumGalleryReady = 'true';

          const thumbs = Array.from(gallery.querySelectorAll('[data-gallery-thumb]'));
          const slides = Array.from(gallery.querySelectorAll('[data-gallery-slide]'));
          const navButtons = Array.from(gallery.querySelectorAll('[data-gallery-nav]'));

          if (thumbs.length && !gallery.querySelector('[data-gallery-thumb].is-active')) {
            thumbs[0].classList.add('is-active');
          }

          if (slides.length && !gallery.querySelector('[data-gallery-slide].is-active')) {
            slides[0].classList.add('is-active');
          }

          const setActiveGalleryImage = (index) => {
            thumbs.forEach((item) => {
              item.classList.toggle('is-active', item.dataset.galleryIndex === index);
            });

            slides.forEach((slide) => {
              slide.classList.toggle('is-active', slide.dataset.galleryIndex === index);
            });
          };

          gallery.addEventListener('premium:gallery:show', (event) => {
            if (!event.detail?.index) return;
            setActiveGalleryImage(String(event.detail.index));
          });

          thumbs.forEach((thumb) => {
            thumb.addEventListener('click', () => setActiveGalleryImage(thumb.dataset.galleryIndex));
          });

          navButtons.forEach((button) => {
            button.addEventListener('click', () => {
              if (!slides.length) return;

              const activeIndex = slides.findIndex((slide) => slide.classList.contains('is-active'));
              const currentIndex = activeIndex >= 0 ? activeIndex : 0;
              const direction = button.dataset.galleryNav === 'prev' ? -1 : 1;
              const nextIndex = (currentIndex + direction + slides.length) % slides.length;

              setActiveGalleryImage(slides[nextIndex].dataset.galleryIndex);
            });
          });
        });
      };

      const normalizePremiumValue = (value) => String(value || '').trim().toLowerCase();
      const premiumProductData = {{ closest.product | default: product | json }};

      const getPremiumSelectedOptions = (productRoot) => {
        if (!premiumProductData || !Array.isArray(premiumProductData.options)) return [];

        return premiumProductData.options.map((optionName, index) => {
          const normalizedOptionName = normalizePremiumValue(optionName);
          const checkedInput = Array.from(productRoot.querySelectorAll('input[type="radio"]:checked')).find((input) => {
            const name = normalizePremiumValue(input.name);
            const formText = normalizePremiumValue(input.closest('fieldset, .product-form__input, .variant-picker, [class*="variant"]')?.textContent);
            return name.includes(normalizedOptionName) || formText.includes(normalizedOptionName);
          });

          if (checkedInput) return checkedInput.value;

          const selectedSelect = Array.from(productRoot.querySelectorAll('select')).find((select) => {
            const name = normalizePremiumValue(select.name || select.id || select.getAttribute('aria-label'));
            const formText = normalizePremiumValue(select.closest('.product-form__input, .variant-picker, [class*="variant"]')?.textContent);
            return name.includes(normalizedOptionName) || formText.includes(normalizedOptionName);
          });

          if (selectedSelect) return selectedSelect.value;

          return premiumProductData.selected_or_first_available_variant?.options?.[index] || '';
        });
      };

      const getPremiumSelectedVariant = (productRoot, selectedValue, optionName) => {
        if (!premiumProductData || !Array.isArray(premiumProductData.variants)) return null;

        const selectedOptions = getPremiumSelectedOptions(productRoot);
        const normalizedSelectedValue = normalizePremiumValue(selectedValue);
        const normalizedOptionName = normalizePremiumValue(optionName);
        const selectedOptionIndex = Array.isArray(premiumProductData.options)
          ? premiumProductData.options.findIndex((name) => normalizePremiumValue(name) === normalizedOptionName)
          : -1;

        if (selectedOptionIndex >= 0 && normalizedSelectedValue) {
          selectedOptions[selectedOptionIndex] = selectedValue;
        }

        const exactVariant = premiumProductData.variants.find((variant) => {
          if (!Array.isArray(variant.options) || variant.options.length !== selectedOptions.length) return false;
          return variant.options.every((optionValue, index) => {
            return normalizePremiumValue(optionValue) === normalizePremiumValue(selectedOptions[index]);
          });
        });

        if (exactVariant) return exactVariant;

        if (normalizedSelectedValue) {
          const colorVariant = premiumProductData.variants.find((variant) => {
            const hasColor = Array.isArray(variant.options) && variant.options.some((optionValue) => {
              return normalizePremiumValue(optionValue) === normalizedSelectedValue;
            });
            return hasColor && (variant.featured_media || variant.featured_image);
          });
          if (colorVariant) return colorVariant;
        }

        const variantIdInput = productRoot.querySelector('form[action*="/cart/add"] [name="id"], [name="id"]');
        const selectedVariantId = variantIdInput && variantIdInput.value ? String(variantIdInput.value) : '';
        return premiumProductData.variants.find((variant) => String(variant.id) === selectedVariantId) || null;
      };

      const getPremiumImageKey = (value) => {
        const rawValue = String(value || '').trim().toLowerCase();
        if (!rawValue) return '';

        const withoutQuery = rawValue.split('?')[0];
        const fileName = withoutQuery.split('/').pop() || withoutQuery;
        return fileName
          .replace(/_(?:[0-9]+x[0-9]*|x[0-9]+|pico|icon|thumb|small|compact|medium|large|grande|master)(?=\.)/g, '')
          .replace(/\.(?:jpg|jpeg|png|webp|gif)$/g, '');
      };

      const getGalleryItemSearchText = (item) => {
        const image = item.querySelector('img');
        return normalizePremiumValue([
          item.dataset.gallerySearch,
          item.dataset.gallerySrc,
          item.getAttribute('aria-label'),
          image?.alt,
          image?.currentSrc,
          image?.src,
        ].filter(Boolean).join(' '));
      };

      const showPremiumGalleryVariantImage = (productRoot, selectedValue, fallbackGalleryIndex, optionName) => {
        const gallery = productRoot.querySelector('[data-premium-gallery]');
        if (!gallery) return;

        const selectedVariant = getPremiumSelectedVariant(productRoot, selectedValue, optionName);
        const variantImage = selectedVariant?.featured_media || selectedVariant?.featured_image || null;
        const mediaIds = [
          selectedVariant?.featured_media?.id,
          selectedVariant?.featured_image?.id,
          variantImage?.id,
        ].filter(Boolean).map(String);
        const searchTerms = [
          selectedValue,
          variantImage?.alt,
          variantImage?.src,
          variantImage?.url,
          ...(Array.isArray(selectedVariant?.options) ? selectedVariant.options : []),
        ].map(normalizePremiumValue).filter(Boolean);
        const galleryItems = Array.from(gallery.querySelectorAll('[data-gallery-slide], [data-gallery-thumb]'));
        const variantImageKeys = [
          variantImage?.src,
          variantImage?.url,
          selectedVariant?.featured_image?.src,
          selectedVariant?.featured_image?.url,
        ].map(getPremiumImageKey).filter(Boolean);

        let match = galleryItems.find((item) => {
          return [item.dataset.galleryMediaId, item.dataset.galleryImageId].some((id) => id && mediaIds.includes(String(id)));
        });

        if (!match && variantImageKeys.length) {
          match = galleryItems.find((item) => {
            const image = item.querySelector('img');
            const itemKeys = [
              item.dataset.gallerySrc,
              image?.currentSrc,
              image?.src,
            ].map(getPremiumImageKey).filter(Boolean);
            return itemKeys.some((itemKey) => variantImageKeys.includes(itemKey));
          });
        }

        if (!match && searchTerms.length) {
          match = galleryItems.find((item) => {
            const searchText = getGalleryItemSearchText(item);
            return searchTerms.some((term) => term && searchText.includes(term));
          });
        }

        if (!match && fallbackGalleryIndex) {
          match = galleryItems.find((item) => String(item.dataset.galleryIndex) === String(fallbackGalleryIndex));
        }

        if (match?.dataset.galleryIndex) {
          gallery.dispatchEvent(new CustomEvent('premium:gallery:show', {
            bubbles: true,
            detail: { index: match.dataset.galleryIndex },
          }));
        }
      };

      const markPremiumNativeColorPickers = (productRoot, optionName, values) => {
        productRoot.querySelectorAll('fieldset, .product-form__input, .variant-picker, [class*="variant-picker"], [class*="variant-option"]').forEach((candidate) => {
          if (candidate.closest('[data-color-pill-group]')) return;
          const candidateText = normalizePremiumValue(candidate.textContent);
          const hasOptionName = optionName && candidateText.includes(optionName);
          const hasMatchingValue = Array.from(candidate.querySelectorAll('input[type="radio"], option, label')).some((item) => {
            return values.includes(normalizePremiumValue(item.value || item.textContent));
          });
          if (hasOptionName && hasMatchingValue) candidate.classList.add('premium-trucker-product__native-color-picker');
        });
      };

      const initPremiumColorPills = (root = document) => {
        root.querySelectorAll('[data-color-pill-group]').forEach((group) => {
          const productRoot = group.closest('.premium-trucker-product') || document;
          const optionName = normalizePremiumValue(group.dataset.optionName);
          const buttons = Array.from(group.querySelectorAll('[data-color-pill]'));
          const currentLabel = group.querySelector('[data-color-pill-current]');
          const values = buttons.map((button) => normalizePremiumValue(button.dataset.optionValue));

          markPremiumNativeColorPickers(productRoot, optionName, values);
          if (group.dataset.colorPillsReady === 'true') return;
          group.dataset.colorPillsReady = 'true';

          const setActivePill = (value) => {
            const normalizedValue = normalizePremiumValue(value);
            buttons.forEach((button) => {
              const isActive = normalizePremiumValue(button.dataset.optionValue) === normalizedValue;
              button.classList.toggle('is-active', isActive);
              button.setAttribute('aria-pressed', isActive ? 'true' : 'false');
              if (isActive && currentLabel) currentLabel.textContent = button.dataset.optionValue;
            });
          };

          const syncNativePicker = (value, fallbackGalleryIndex) => {
            const normalizedValue = normalizePremiumValue(value);
            let matched = false;

            productRoot.querySelectorAll('input[type="radio"]').forEach((input) => {
              if (normalizePremiumValue(input.value) !== normalizedValue) return;
              input.checked = true;
              input.dispatchEvent(new Event('input', { bubbles: true }));
              input.dispatchEvent(new Event('change', { bubbles: true }));
              matched = true;
            });

            if (!matched) {
              productRoot.querySelectorAll('select').forEach((select) => {
                Array.from(select.options).forEach((option) => {
                  const optionValue = normalizePremiumValue(option.value || option.textContent);
                  if (optionValue !== normalizedValue) return;
                  select.value = option.value;
                  select.dispatchEvent(new Event('input', { bubbles: true }));
                  select.dispatchEvent(new Event('change', { bubbles: true }));
                  matched = true;
                });
              });
            }

            setActivePill(value);
            showPremiumGalleryVariantImage(productRoot, value, fallbackGalleryIndex, group.dataset.optionName);
            window.setTimeout(() => showPremiumGalleryVariantImage(productRoot, value, fallbackGalleryIndex, group.dataset.optionName), 0);
            window.setTimeout(() => showPremiumGalleryVariantImage(productRoot, value, fallbackGalleryIndex, group.dataset.optionName), 150);
            window.setTimeout(() => showPremiumGalleryVariantImage(productRoot, value, fallbackGalleryIndex, group.dataset.optionName), 450);
            window.setTimeout(() => markPremiumNativeColorPickers(productRoot, optionName, values), 0);
            window.setTimeout(() => markPremiumNativeColorPickers(productRoot, optionName, values), 150);
          };

          buttons.forEach((button) => {
            button.addEventListener('click', () => syncNativePicker(button.dataset.optionValue, button.dataset.optionIndex));
          });

          productRoot.addEventListener('change', (event) => {
            const target = event.target;
            if (!target || !('value' in target)) return;
            if (values.includes(normalizePremiumValue(target.value))) {
              const matchingButton = buttons.find((button) => normalizePremiumValue(button.dataset.optionValue) === normalizePremiumValue(target.value));
              setActivePill(target.value);
              showPremiumGalleryVariantImage(productRoot, target.value, matchingButton?.dataset.optionIndex, group.dataset.optionName);
              window.setTimeout(() => showPremiumGalleryVariantImage(productRoot, target.value, matchingButton?.dataset.optionIndex, group.dataset.optionName), 0);
              window.setTimeout(() => showPremiumGalleryVariantImage(productRoot, target.value, matchingButton?.dataset.optionIndex, group.dataset.optionName), 150);
              window.setTimeout(() => showPremiumGalleryVariantImage(productRoot, target.value, matchingButton?.dataset.optionIndex, group.dataset.optionName), 450);
            }
            window.setTimeout(() => markPremiumNativeColorPickers(productRoot, optionName, values), 0);
            window.setTimeout(() => markPremiumNativeColorPickers(productRoot, optionName, values), 150);
          });

          const observer = new MutationObserver(() => {
            markPremiumNativeColorPickers(productRoot, optionName, values);
            initPremiumColorPills(productRoot);
          });
          observer.observe(productRoot, { childList: true, subtree: true });
        });
      };

      initPremiumGallery();
      initPremiumColorPills();
      document.addEventListener('shopify:section:load', (event) => initPremiumGallery(event.target));
      document.addEventListener('shopify:section:load', (event) => initPremiumColorPills(event.target));
    })();
  </script>
{% endif %}

<script>
  (() => {
    const ROOT_SELECTOR = '[data-customhouse-creator-actions]';
    const ENDPOINT = '/apps/customhouse/api/inkybay';

    const productGid = (value) => {
      const id = String(value || '').trim();
      return /^gid:\/\/shopify\/Product\/\d+$/.test(id)
        ? id
        : /^\d+$/.test(id)
          ? `gid://shopify/Product/${id}`
          : '';
    };

    const variantGid = (value) => {
      const id = String(value || '').trim();
      return /^gid:\/\/shopify\/ProductVariant\/\d+$/.test(id)
        ? id
        : /^\d+$/.test(id)
          ? `gid://shopify/ProductVariant/${id}`
          : '';
    };

    const currentVariantId = (root) => {
      const sectionRoot = root.closest('.premium-trucker-product');
      const formVariant = sectionRoot?.querySelector(
        '[data-marked-product-actions] form[action*="/cart/add"] [name="id"]'
      )?.value;
      const urlVariant = new URL(window.location.href).searchParams.get('variant');
      return variantGid(urlVariant || formVariant || root.dataset.variantId);
    };

    const requestJson = async (url, options = {}) => {
      const response = await fetch(url, {
        credentials: 'same-origin',
        headers: {
          Accept: 'application/json',
          ...(options.body ? { 'Content-Type': 'application/json' } : {}),
        },
        ...options,
      });
      const body = await response.json().catch(() => null);
      if (!response.ok || body?.success !== true) throw new Error('request_failed');
      return body.data;
    };

    const setMessage = (root, message = '') => {
      const element = root.querySelector('[data-creator-action-message]');
      if (!element) return;
      element.textContent = message;
      element.hidden = !message;
    };

    const sessionKey = (root) => {
      if (root.dataset.creatorSessionKey) return root.dataset.creatorSessionKey;
      const value = typeof crypto.randomUUID === 'function'
        ? crypto.randomUUID().replaceAll('-', '')
        : `${Date.now()}_${Math.random().toString(36).slice(2)}`;
      root.dataset.creatorSessionKey = value;
      return value;
    };

    const bindCreatorButton = (root) => {
      const button = root.querySelector('[data-create-for-collection]');
      if (!button || button.dataset.creatorActionBound === 'true') return;
      button.dataset.creatorActionBound = 'true';
      button.addEventListener('click', async () => {
        if (button.getAttribute('aria-busy') === 'true') return;
        const productId = productGid(root.dataset.productId);
        const variantId = currentVariantId(root);
        if (!productId || !variantId) {
          setMessage(root, 'We could not start your creator design. Please try again.');
          return;
        }

        button.disabled = true;
        button.setAttribute('aria-busy', 'true');
        button.textContent = 'Creating design session\u2026';
        setMessage(root);
        try {
          const session = await requestJson(`${ENDPOINT}/creator-designs/start`, {
            method: 'POST',
            body: JSON.stringify({
              productId,
              variantId,
              idempotencyKey: sessionKey(root),
            }),
          });
          if (!session?.workspaceUrl || !session.workspaceUrl.startsWith('/apps/customhouse/')) {
            throw new Error('invalid_workspace');
          }
          window.location.assign(session.workspaceUrl);
        } catch {
          console.warn('customhouse_creator_session_unavailable');
          button.disabled = false;
          button.setAttribute('aria-busy', 'false');
          button.textContent = 'Create for My Collection';
          setMessage(root, 'We could not start your creator design. Please try again.');
        }
      });
    };

    const initialize = async (root) => {
      if (root.dataset.creatorActionsReady === 'true') return;
      root.dataset.creatorActionsReady = 'true';
      root.hidden = true;

      if (
        root.dataset.productType !== 'global_customizable' ||
        root.dataset.pitchprintEnabled !== 'true' ||
        root.dataset.creatorPublishingEnabled !== 'true'
      ) return;

      const productId = productGid(root.dataset.productId);
      if (!productId) return;

      try {
        const query = new URLSearchParams({ product_id: productId });
        const eligibility = await requestJson(`${ENDPOINT}/eligibility?${query}`);
        if (
          eligibility?.isApprovedCreator === true &&
          eligibility?.isSuspendedCreator === false &&
          eligibility?.creatorPublishAvailable === true
        ) {
          bindCreatorButton(root);
          root.hidden = false;
        }
      } catch {
        console.warn('customhouse_creator_eligibility_unavailable');
      }
    };

    const initializeAll = (scope = document) => {
      scope.querySelectorAll(ROOT_SELECTOR).forEach((root) => initialize(root));
    };

    if (!window.__customHouseDirectCreatorActionsBound) {
      window.__customHouseDirectCreatorActionsBound = true;
      document.addEventListener('shopify:section:load', (event) => initializeAll(event.target));
    }
    initializeAll();
  })();
</script>

