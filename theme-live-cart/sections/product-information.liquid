          {% if section.settings.customize_icon_image != blank %}
            {{ section.settings.customize_icon_image | image_url: width: 80 | image_tag: loading: 'lazy', alt: '' }}
          {% else %}
            <svg viewBox="0 0 24 24" focusable="false">
              <path d="M12 2.8 14.1 8l5.6.4-4.3 3.6 1.4 5.4L12 14.4l-4.8 3 1.4-5.4-4.3-3.6L9.9 8 12 2.8Z" fill="currentColor"/>
            </svg>
          {% endif %}
        </span>
        <span>{{ section.settings.customize_button_label | escape }}</span>
        <span class="premium-trucker-product__customize-arrow" aria-hidden="true">
          <svg viewBox="0 0 24 24" focusable="false">
            <path d="M5 12h13m-5-5 5 5-5 5" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
