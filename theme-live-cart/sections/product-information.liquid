

<script type="application/ld+json">
  {{ closest.product | structured_data }}
</script>
<script>
  (() => {
    const params = new URLSearchParams(window.location.search);
    if (params.get('open_customizer') === '1' || params.get('open_pitchprint') === '1') {
      document.documentElement.classList.add('pitchprint-is-auto-opening');
    }
  })();
</script>
{% liquid
  assign current_product = closest.product | default: product
  assign current_product_type = current_product.metafields.customhouse.product_type.value | downcase
  assign current_inkybay_enabled = current_product.metafields.customhouse.inkybay_enabled.value
  assign current_pitchprint_enabled = current_product.metafields.customhouse.pitchprint_enabled.value
  assign current_creator_publishing_enabled = current_product.metafields.customhouse.creator_publishing_enabled.value
  assign is_creator_fixed_product = false
  assign is_inkybay_designlab_product = false
  assign is_pitchprint_designlab_product = false
  assign is_pitchprint_required_product = false

  if current_product_type == 'creator_fixed' or current_product.tags contains 'creator-fixed'
    assign is_creator_fixed_product = true
  endif

  unless is_creator_fixed_product
    if current_product_type == 'global_customizable' and current_pitchprint_enabled == true
      assign is_inkybay_designlab_product = true
      assign is_pitchprint_designlab_product = true
    elsif current_product_type == 'global_customizable' and current_inkybay_enabled == true
      assign is_inkybay_designlab_product = true
    elsif current_product.tags contains 'pitchprint' or current_product.tags contains 'pitchprint-enabled'
      assign is_inkybay_designlab_product = true
      assign is_pitchprint_designlab_product = true
    elsif current_product.tags contains 'pitchprint-designlab' or current_product.tags contains 'pitchprint-options'
      assign is_inkybay_designlab_product = true
      assign is_pitchprint_designlab_product = true
    elsif current_product.tags contains 'inkybay-designlab' or current_product.tags contains 'inkybay-options'
      assign is_inkybay_designlab_product = true
    endif
  endunless

  if is_pitchprint_designlab_product and current_product.tags contains 'pitchprint-required'
    assign is_pitchprint_required_product = true
  endif

  assign show_mobile_customize = false
  if section.settings.show_customize_button and is_inkybay_designlab_product
    assign show_mobile_customize = true
  endif

  # Keep storefront purchase controls active when Shopify reports sold out.
  # Shopify Admin must still allow overselling for the backend cart request.
  assign force_allow_purchase = section.settings.force_allow_purchase
%}

{% capture media_gallery %}
  <div class="premium-trucker-product__media-wrap">
    {% liquid
      assign custom_gallery_count = 0
      if section.settings.gallery_image_1 != blank
        assign custom_gallery_count = custom_gallery_count | plus: 1
      endif
      if section.settings.gallery_image_2 != blank
        assign custom_gallery_count = custom_gallery_count | plus: 1
      endif
      if section.settings.gallery_image_3 != blank
        assign custom_gallery_count = custom_gallery_count | plus: 1
      endif
      if section.settings.gallery_image_4 != blank
        assign custom_gallery_count = custom_gallery_count | plus: 1
      endif
      if section.settings.gallery_image_5 != blank
        assign custom_gallery_count = custom_gallery_count | plus: 1
      endif
      if section.settings.gallery_image_6 != blank
        assign custom_gallery_count = custom_gallery_count | plus: 1
      endif
      assign first_gallery_index = blank
      if section.settings.gallery_image_1 != blank and first_gallery_index == blank
        assign first_gallery_index = '1'
      endif
      if section.settings.gallery_image_2 != blank and first_gallery_index == blank
        assign first_gallery_index = '2'
      endif
      if section.settings.gallery_image_3 != blank and first_gallery_index == blank
        assign first_gallery_index = '3'
      endif
      if section.settings.gallery_image_4 != blank and first_gallery_index == blank
        assign first_gallery_index = '4'
      endif
      if section.settings.gallery_image_5 != blank and first_gallery_index == blank
        assign first_gallery_index = '5'
      endif
      if section.settings.gallery_image_6 != blank and first_gallery_index == blank
        assign first_gallery_index = '6'
      endif
    %}

    {% if section.settings.enable_custom_gallery and custom_gallery_count > 0 %}
      <div class="premium-trucker-product__custom-gallery" data-premium-gallery>
        <div class="premium-trucker-product__custom-thumbs" role="tablist" aria-label="Product images">
          {% if section.settings.gallery_image_1 != blank %}
            <button class="premium-trucker-product__custom-thumb{% if first_gallery_index == '1' %} is-active{% endif %}" type="button" data-gallery-thumb data-gallery-index="1" aria-label="Show image 1">
              {{ section.settings.gallery_image_1 | image_url: width: 240 | image_tag: loading: 'lazy', alt: section.settings.gallery_image_1_alt }}
            </button>
          {% endif %}
          {% if section.settings.gallery_image_2 != blank %}
            <button class="premium-trucker-product__custom-thumb{% if first_gallery_index == '2' %} is-active{% endif %}" type="button" data-gallery-thumb data-gallery-index="2" aria-label="Show image 2">
              {{ section.settings.gallery_image_2 | image_url: width: 240 | image_tag: loading: 'lazy', alt: section.settings.gallery_image_2_alt }}
            </button>
          {% endif %}
          {% if section.settings.gallery_image_3 != blank %}
            <button class="premium-trucker-product__custom-thumb{% if first_gallery_index == '3' %} is-active{% endif %}" type="button" data-gallery-thumb data-gallery-index="3" aria-label="Show image 3">
              {{ section.settings.gallery_image_3 | image_url: width: 240 | image_tag: loading: 'lazy', alt: section.settings.gallery_image_3_alt }}
            </button>
          {% endif %}
          {% if section.settings.gallery_image_4 != blank %}
            <button class="premium-trucker-product__custom-thumb{% if first_gallery_index == '4' %} is-active{% endif %}" type="button" data-gallery-thumb data-gallery-index="4" aria-label="Show image 4">
              {{ section.settings.gallery_image_4 | image_url: width: 240 | image_tag: loading: 'lazy', alt: section.settings.gallery_image_4_alt }}
            </button>
          {% endif %}
          {% if section.settings.gallery_image_5 != blank %}
            <button class="premium-trucker-product__custom-thumb{% if first_gallery_index == '5' %} is-active{% endif %}{% if custom_gallery_count > 4 %} has-more-count{% endif %}" type="button" data-gallery-thumb data-gallery-index="5" aria-label="Show image 5">
              {{ section.settings.gallery_image_5 | image_url: width: 240 | image_tag: loading: 'lazy', alt: section.settings.gallery_image_5_alt }}
              {% if custom_gallery_count > 4 %}
                <span class="premium-trucker-product__more-count">+{{ custom_gallery_count | minus: 4 }}</span>
              {% endif %}
            </button>
          {% endif %}
        </div>

        <div class="premium-trucker-product__custom-main">
          {% if section.settings.gallery_image_1 != blank %}
            <div class="premium-trucker-product__custom-slide{% if first_gallery_index == '1' %} is-active{% endif %}" data-gallery-slide data-gallery-index="1">
              {{ section.settings.gallery_image_1 | image_url: width: 1600 | image_tag: loading: 'lazy', alt: section.settings.gallery_image_1_alt, widths: '600, 900, 1200, 1600', sizes: '(min-width: 1100px) 58vw, 100vw' }}
            </div>
          {% endif %}
          {% if section.settings.gallery_image_2 != blank %}
            <div class="premium-trucker-product__custom-slide{% if first_gallery_index == '2' %} is-active{% endif %}" data-gallery-slide data-gallery-index="2">
              {{ section.settings.gallery_image_2 | image_url: width: 1600 | image_tag: loading: 'lazy', alt: section.settings.gallery_image_2_alt, widths: '600, 900, 1200, 1600', sizes: '(min-width: 1100px) 58vw, 100vw' }}
            </div>
          {% endif %}
          {% if section.settings.gallery_image_3 != blank %}
            <div class="premium-trucker-product__custom-slide{% if first_gallery_index == '3' %} is-active{% endif %}" data-gallery-slide data-gallery-index="3">
              {{ section.settings.gallery_image_3 | image_url: width: 1600 | image_tag: loading: 'lazy', alt: section.settings.gallery_image_3_alt, widths: '600, 900, 1200, 1600', sizes: '(min-width: 1100px) 58vw, 100vw' }}
            </div>
          {% endif %}
          {% if section.settings.gallery_image_4 != blank %}
            <div class="premium-trucker-product__custom-slide{% if first_gallery_index == '4' %} is-active{% endif %}" data-gallery-slide data-gallery-index="4">
              {{ section.settings.gallery_image_4 | image_url: width: 1600 | image_tag: loading: 'lazy', alt: section.settings.gallery_image_4_alt, widths: '600, 900, 1200, 1600', sizes: '(min-width: 1100px) 58vw, 100vw' }}
            </div>
          {% endif %}
          {% if section.settings.gallery_image_5 != blank %}
            <div class="premium-trucker-product__custom-slide{% if first_gallery_index == '5' %} is-active{% endif %}" data-gallery-slide data-gallery-index="5">
              {{ section.settings.gallery_image_5 | image_url: width: 1600 | image_tag: loading: 'lazy', alt: section.settings.gallery_image_5_alt, widths: '600, 900, 1200, 1600', sizes: '(min-width: 1100px) 58vw, 100vw' }}
            </div>
          {% endif %}
          {% if section.settings.gallery_image_6 != blank %}
            <div class="premium-trucker-product__custom-slide{% if first_gallery_index == '6' %} is-active{% endif %}" data-gallery-slide data-gallery-index="6">
              {{ section.settings.gallery_image_6 | image_url: width: 1600 | image_tag: loading: 'lazy', alt: section.settings.gallery_image_6_alt, widths: '600, 900, 1200, 1600', sizes: '(min-width: 1100px) 58vw, 100vw' }}
            </div>
          {% endif %}
          {% if custom_gallery_count > 1 %}
            <button class="premium-trucker-product__gallery-arrow premium-trucker-product__gallery-arrow--prev" type="button" data-gallery-nav="prev" aria-label="Previous product image">
              <svg viewBox="0 0 24 24" focusable="false" aria-hidden="true">
                <path d="M15 5 8 12l7 7" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
            <button class="premium-trucker-product__gallery-arrow premium-trucker-product__gallery-arrow--next" type="button" data-gallery-nav="next" aria-label="Next product image">
              <svg viewBox="0 0 24 24" focusable="false" aria-hidden="true">
                <path d="m9 5 7 7-7 7" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
          {% endif %}
        </div>
      </div>
    {% else %}
      {% liquid
        assign native_gallery_product = closest.product | default: product
        assign native_gallery_count = native_gallery_product.media.size
      %}

      {% if section.settings.enable_premium_style and native_gallery_count > 0 %}
        <div class="premium-trucker-product__custom-gallery premium-trucker-product__product-media-gallery" data-premium-gallery>
          <div class="premium-trucker-product__custom-thumbs" role="tablist" aria-label="Product media">
            {% assign rendered_gallery_thumb_count = 0 %}
            {% for media in native_gallery_product.media %}
              {% assign media_index = forloop.index %}
              {% assign media_alt = media.alt | default: native_gallery_product.title | escape %}
              {% assign media_preview = media.preview_image | default: native_gallery_product.featured_image %}
              {% if media_preview != blank %}
                {% assign rendered_gallery_thumb_count = rendered_gallery_thumb_count | plus: 1 %}
                {% if rendered_gallery_thumb_count <= 5 %}
                  <button class="premium-trucker-product__custom-thumb{% if forloop.first %} is-active{% endif %}{% if rendered_gallery_thumb_count == 5 and native_gallery_count > 4 %} has-more-count{% endif %}" type="button" data-gallery-thumb data-gallery-index="{{ media_index }}" data-gallery-media-id="{{ media.id }}" data-gallery-image-id="{{ media_preview.id | default: media.id }}" data-gallery-src="{{ media_preview | image_url: width: 1600 }}" aria-label="Show product media {{ media_index }}">
                    {{ media_preview | image_url: width: 320 | image_tag: loading: 'lazy', alt: media_alt }}
                    {% if rendered_gallery_thumb_count == 5 and native_gallery_count > 4 %}
                      <span class="premium-trucker-product__more-count">+{{ native_gallery_count | minus: 4 }}</span>
                    {% endif %}
                  </button>
                {% endif %}
              {% endif %}
            {% endfor %}
          </div>

          <div class="premium-trucker-product__custom-main">
            {% for media in native_gallery_product.media %}
              {% assign media_index = forloop.index %}
              {% assign media_alt = media.alt | default: native_gallery_product.title | escape %}
              {% assign media_preview = media.preview_image | default: native_gallery_product.featured_image %}
              {% if media_preview != blank %}
                <div class="premium-trucker-product__custom-slide{% if forloop.first %} is-active{% endif %}" data-gallery-slide data-gallery-index="{{ media_index }}" data-gallery-media-id="{{ media.id }}" data-gallery-image-id="{{ media_preview.id | default: media.id }}" data-gallery-src="{{ media_preview | image_url: width: 1600 }}">
                  {{ media_preview | image_url: width: 1600 | image_tag: loading: 'eager', alt: media_alt, widths: '600, 900, 1200, 1600', sizes: '(min-width: 1100px) 58vw, 100vw' }}
                </div>
              {% endif %}
            {% endfor %}
            {% if native_gallery_count > 1 %}
              <button class="premium-trucker-product__gallery-arrow premium-trucker-product__gallery-arrow--prev" type="button" data-gallery-nav="prev" aria-label="Previous product image">
                <svg viewBox="0 0 24 24" focusable="false" aria-hidden="true">
                  <path d="M15 5 8 12l7 7" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>
              <button class="premium-trucker-product__gallery-arrow premium-trucker-product__gallery-arrow--next" type="button" data-gallery-nav="next" aria-label="Next product image">
                <svg viewBox="0 0 24 24" focusable="false" aria-hidden="true">
                  <path d="m9 5 7 7-7 7" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>
            {% endif %}
          </div>
        </div>
      {% else %}
        <div class="premium-trucker-product__native-gallery">
          {%- content_for 'block',
            type: '_product-media-gallery',
            id: 'media-gallery',
            closest.product: closest.product
          -%}
        </div>
      {% endif %}
    {% endif %}

    {% if section.settings.show_service_badges %}
      <div class="premium-trucker-product__service-row" aria-label="Product service information">
        {% if section.settings.production_time_text != blank %}
          <div class="premium-trucker-product__service-item">
            <span class="premium-trucker-product__service-icon" aria-hidden="true">
              {% if section.settings.production_icon_image != blank %}
                {{ section.settings.production_icon_image | image_url: width: 80 | image_tag: loading: 'lazy', alt: '' }}
              {% else %}
                <svg viewBox="0 0 24 24" focusable="false">
                  <path d="M12 2.8 3.8 7.2v9.4l8.2 4.6 8.2-4.6V7.2L12 2.8Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
                  <path d="M3.8 7.2 12 11.8l8.2-4.6M12 21.2v-9.4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
                </svg>
              {% endif %}
            </span>
            <span>
              <strong>{{ section.settings.production_time_heading | escape }}</strong>
              <small>{{ section.settings.production_time_text | escape }}</small>
            </span>
          </div>
        {% endif %}

        {% if section.settings.shipping_time_text != blank %}
          <div class="premium-trucker-product__service-item">
            <span class="premium-trucker-product__service-icon" aria-hidden="true">
              {% if section.settings.shipping_icon_image != blank %}
                {{ section.settings.shipping_icon_image | image_url: width: 80 | image_tag: loading: 'lazy', alt: '' }}
              {% else %}
                <svg viewBox="0 0 24 24" focusable="false">
                  <path d="M3 7h11v9H3V7Zm11 3h3.7l3.3 3.3V16h-7v-6Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
                  <path d="M7 19.2a2 2 0 1 0 0-4 2 2 0 0 0 0 4Zm10 0a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z" fill="none" stroke="currentColor" stroke-width="1.8"/>
                </svg>
              {% endif %}
            </span>
            <span>
              <strong>{{ section.settings.shipping_time_heading | escape }}</strong>
              <small>{{ section.settings.shipping_time_text | escape }}</small>
            </span>
          </div>
        {% endif %}

        {% if section.settings.returns_text != blank %}
          <div class="premium-trucker-product__service-item">
            <span class="premium-trucker-product__service-icon" aria-hidden="true">
              {% if section.settings.returns_icon_image != blank %}
                {{ section.settings.returns_icon_image | image_url: width: 80 | image_tag: loading: 'lazy', alt: '' }}
              {% else %}
                <svg viewBox="0 0 24 24" focusable="false">
                  <path d="M19 12a7 7 0 1 1-2.1-5M19 4.5v4h-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                  <path d="M12 8.2v4.2l3 1.8" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              {% endif %}
            </span>
            <span>
              <strong>{{ section.settings.returns_heading | escape }}</strong>
              <small>{{ section.settings.returns_text | escape }}</small>
            </span>
          </div>
        {% endif %}
      </div>
    {% endif %}
  </div>
{% endcapture %}

{% capture product_details %}
  <div class="premium-trucker-product__details-wrap">
    {% liquid
      assign premium_product = closest.product | default: product
      assign premium_variant = premium_product.selected_or_first_available_variant
      assign premium_price = premium_variant.price | default: premium_product.price
      assign premium_compare_price = premium_variant.compare_at_price | default: premium_product.compare_at_price
      assign premium_savings = 0
      if premium_compare_price != blank and premium_compare_price > premium_price
        assign premium_savings = premium_compare_price | minus: premium_price
      endif
      assign premium_creator_profile = premium_product.metafields.customhouse.creator_profile.value
      assign premium_creator_name = premium_product.metafields.customhouse.creator_display_name.value
      assign premium_creator_handle = premium_product.metafields.customhouse.creator_handle.value
      if premium_creator_name == blank and premium_creator_profile != blank
        assign premium_creator_name = premium_creator_profile.display_name.value | default: premium_creator_profile.display_name | default: premium_creator_profile.displayName.value | default: premium_creator_profile.displayName
      endif
      if premium_creator_handle == blank and premium_creator_profile != blank
        assign premium_creator_handle = premium_creator_profile.creator_handle.value | default: premium_creator_profile.creatorHandle.value | default: premium_creator_profile.handle.value | default: premium_creator_profile.handle
      endif
      if is_creator_locked_product
        assign premium_creator_name = premium_creator_name | default: premium_creator_handle | default: section.settings.creator_name
      else
        assign premium_creator_name = section.settings.creator_name
      endif
      assign premium_creator_brand = section.settings.creator_label | default: 'Custom House'
      if is_creator_locked_product
        assign premium_creator_brand = 'Custom House'
      endif
    %}

    {% if premium_product.title != blank %}
      <h1 class="premium-trucker-product__screenshot-title">{{ premium_product.title | escape }}</h1>
    {% endif %}

    {% if section.settings.show_product_meta %}
      <div class="premium-trucker-product__meta">
        {% if premium_creator_brand != blank or premium_creator_name != blank %}
          <div class="premium-trucker-product__creator">
            {% if section.settings.creator_avatar_image != blank %}
              <span class="premium-trucker-product__creator-avatar" aria-hidden="true">
                {{ section.settings.creator_avatar_image | image_url: width: 80 | image_tag: loading: 'lazy', alt: '' }}
              </span>
            {% endif %}
            {% if premium_creator_brand != blank %}
              <span class="premium-trucker-product__creator-brand">{{ premium_creator_brand | escape }}</span>
            {% endif %}
            {% if premium_creator_name != blank %}
              <strong class="premium-trucker-product__creator-name">
                {% if is_creator_locked_product %}by {% endif %}{{ premium_creator_name | escape }}
              </strong>
            {% endif %}
            {% if section.settings.show_verified_badge %}
              <span class="premium-trucker-product__verified" aria-label="Verified creator">
                <svg viewBox="0 0 20 20" focusable="false" aria-hidden="true">
                  <path d="M10 1.5 12.1 4l3.2-.4.7 3.1 2.8 1.6-1.4 2.9 1.4 2.9-2.8 1.6-.7 3.1-3.2-.4L10 20l-2.1-2.5-3.2.4-.7-3.1-2.8-1.6 1.4-2.9-1.4-2.9L4 5.8l.7-3.1 3.2.4L10 1.5Z" fill="currentColor"/>
                  <path d="m6.8 10.2 2 2 4.4-4.6" fill="none" stroke="#fff" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            {% endif %}
          </div>
        {% endif %}

        {% if section.settings.rating_text != blank or section.settings.reviews_text != blank %}
          <div class="premium-trucker-product__rating" aria-label="{{ section.settings.rating_text | escape }} {{ section.settings.reviews_text | escape }}">
            <span class="premium-trucker-product__stars" aria-hidden="true">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
            {% if section.settings.rating_text != blank %}
              <strong>{{ section.settings.rating_text | escape }}</strong>
            {% endif %}
            {% if section.settings.reviews_text != blank %}
              <span>{{ section.settings.reviews_text | escape }}</span>
            {% endif %}
          </div>
        {% endif %}
      </div>
    {% endif %}

    {% if premium_price != blank %}
      <div class="premium-trucker-product__screenshot-price" aria-label="Product price">
        <span class="premium-trucker-product__sale-price">{{ premium_price | money }}</span>
        {% if premium_compare_price != blank and premium_compare_price > premium_price %}
          <s class="premium-trucker-product__compare-price">{{ premium_compare_price | money }}</s>
          <span class="premium-trucker-product__save-badge">You save {{ premium_savings | money }}</span>
        {% endif %}
      </div>
    {% endif %}

    {% if premium_product.description != blank %}
      <div class="premium-trucker-product__screenshot-description">
        {{ premium_product.description | strip_html | truncate: 170 }}
      </div>
    {% endif %}

    {% unless is_inkybay_designlab_product or is_creator_locked_product %}
    {% for option in premium_product.options_with_values %}
      {% assign option_name_downcase = option.name | downcase %}
      {% if option_name_downcase contains 'color' or option_name_downcase contains 'colour' %}
        <div class="premium-trucker-product__color-pills" data-color-pill-group data-option-name="{{ option.name | escape }}">
          <div class="premium-trucker-product__color-label">
            <span>{{ option.name | escape }}:</span>
            <strong data-color-pill-current>{{ option.selected_value | default: option.values.first | escape }}</strong>
          </div>
          <div class="premium-trucker-product__color-list" role="list" aria-label="{{ option.name | escape }} options">
            {% for value in option.values %}
              {% liquid
                assign value_handle = value | handleize
                assign swatch_color = '#555555'
                case value_handle
                  when 'black'
                    assign swatch_color = '#050505'
                  when 'white'
                    assign swatch_color = '#f3f3f3'
                  when 'navy'
                    assign swatch_color = '#12243d'
                  when 'green'
                    assign swatch_color = '#687329'
                  when 'red'
                    assign swatch_color = '#dd201c'
                  when 'blue'
                    assign swatch_color = '#2457d6'
                  when 'purple'
                    assign swatch_color = '#8a2cff'
                  when 'gray', 'grey'
                    assign swatch_color = '#6f6f6f'
                  when 'charcoal'
                    assign swatch_color = '#282828'
                  when 'silver'
                    assign swatch_color = '#bfc2c5'
                  when 'gold'
                    assign swatch_color = '#d4a640'
                  when 'yellow'
                    assign swatch_color = '#f2cf28'
                  when 'orange'
                    assign swatch_color = '#e37822'
                  when 'brown'
                    assign swatch_color = '#69452c'
                  when 'pink'
                    assign swatch_color = '#e66da3'
                endcase
              %}
              <button
                class="premium-trucker-product__color-pill{% if option.selected_value == value or option.selected_value == blank and forloop.first %} is-active{% endif %}"
                type="button"
                data-color-pill
                data-option-value="{{ value | escape }}"
                data-option-index="{{ forloop.index }}"
                style="--ptp-pill-color: {{ swatch_color }};"
                aria-label="Select {{ value | escape }}"
                aria-pressed="{% if option.selected_value == value or option.selected_value == blank and forloop.first %}true{% else %}false{% endif %}"
              >
                <span class="premium-trucker-product__color-swatch" aria-hidden="true"></span>
                <span>{{ value | escape }}</span>
              </button>
            {% endfor %}
          </div>
        </div>
      {% endif %}
    {% endfor %}
    {% endunless %}

    {% content_for 'block',
      type: '_product-details',
      id: 'product-details',
      closest.product: closest.product
    %}

    {% if is_inkybay_designlab_product and current_creator_publishing_enabled == true %}
      <div
        class="premium-trucker-product__creator-actions"
        data-customhouse-creator-actions
        data-product-id="{{ premium_product.id }}"
        data-variant-id="{{ premium_variant.id }}"
        data-product-handle="{{ premium_product.handle | escape }}"
        data-product-type="global_customizable"
        data-pitchprint-enabled="true"
        data-inkybay-enabled="true"
        data-creator-publishing-enabled="true"
        hidden
      >
        <button
          type="button"
          class="premium-trucker-product__creator-collection-button"
          data-create-for-collection
          aria-busy="false"
        >
          Create for My Collection
        </button>
        <p
          class="premium-trucker-product__creator-action-message"
          data-creator-action-message
          role="status"
          aria-live="polite"
          hidden
        ></p>
      </div>
    {% endif %}

  </div>
{% endcapture %}

{% capture additional_blocks %}
  {% content_for 'blocks' %}
{% endcapture %}

{% if section.settings.enable_sticky_add_to_cart and is_inkybay_designlab_product == false %}
  {% liquid
    assign current_variant = product.selected_or_first_available_variant | default: product.variants.first
    # Get the initial quantity based on quantity rules
    assign initial_quantity = current_variant.quantity_rule.min | default: 1
    assign sticky_variant_available = current_variant.available
    if force_allow_purchase
      assign sticky_variant_available = true
    endif
  %}

  <sticky-add-to-cart
    class="sticky-add-to-cart"
    data-variant-available="{{ sticky_variant_available }}"
    data-product-id="{{ product.id }}"
    data-current-variant-id="{{ current_variant.id }}"
    data-initial-quantity="{{ initial_quantity }}"
    data-default-variant-title="{{ 'products.product.default_title' | t }}"
  >
    <div
      class="sticky-add-to-cart__bar color-custom-popover"
      data-stuck="false"
      ref="stickyBar"
      role="region"
      aria-label="{{ 'products.product.sticky_add_to_cart' | t }}"
    >
      {% liquid
        assign image_to_show = current_variant.featured_image | default: product.featured_image
      %}
      {% if image_to_show %}
        <div
          class="sticky-add-to-cart__image"
        >
          {% assign image_alt = image_to_show.alt | default: product.title | escape %}
          {{
            image_to_show
            | image_url: width: 120
            | image_tag:
              loading: 'lazy',
              alt: image_alt,
              class: 'sticky-add-to-cart__image-img',
              data-testid: 'sticky-product-image',
              srcset: null,
              sizes: null,
              ref: 'productImage'
          }}
        </div>
      {% endif %}

      {% liquid
        assign has_single_option = false
        if product.has_only_default_variant != true and product.options.size == 1
          assign has_single_option = true
        endif

        if image_to_show == blank
          assign has_image = false
        else
          assign has_image = true
        endif
      %}
      <div
        class="sticky-add-to-cart__info"
        data-has-image="{{ has_image }}"
        data-singleton="{{ product.has_only_default_variant }}"
        data-single-option="{{ has_single_option }}"
      >
        <p
          class="sticky-add-to-cart__title"
          data-testid="sticky-product-title"
        >
          {{ product.title | escape }}
        </p>
        <div
          class="sticky-add-to-cart__variant"
          data-testid="sticky-variant-title"
          {% if product.has_only_default_variant %}
            style="display: none;"
          {% endif %}
        >
          {% unless product.has_only_default_variant %}
            {% if current_variant != blank %}
              {% assign variant_title = current_variant.title | escape %}
            {% endif %}
            {{ variant_title }}
          {% endunless %}
        </div>
      </div>

      <div
        class="sticky-add-to-cart__price"
        data-testid="sticky-price-display"
      >
        {% render 'price', product_resource: product, show_sale_price_first: true %}
      </div>

      <button
        type="button"
        class="sticky-add-to-cart__button add-to-cart-button button"
        ref="addToCartButton"
        on:click="/handleAddToCartClick"
        {% if force_allow_purchase == false and current_variant.available == false %}
          disabled
        {% endif %}
      >
        <span
          class="add-to-cart-text"
        >
          {% if current_variant.available or force_allow_purchase %}
            <span class="svg-wrapper">
              {{- 'icon-add-to-cart.svg' | inline_asset_content -}}
            </span>
          {% endif %}
          <span class="add-to-cart-text__content">
            <span>
              {%- if current_variant.available or force_allow_purchase -%}
                {{- 'products.product.add_to_cart' | t -}}
              {%- elsif current_variant == blank -%}
                {{- 'products.product.unavailable' | t -}}
              {%- else -%}
                {{- 'products.product.sold_out' | t -}}
              {%- endif -%}
            </span>
            <span
              ref="quantityDisplay"
              {% if sticky_variant_available and initial_quantity > 1 %}
                style="display: inline;"
              {% else %}
                style="display: none;"
              {% endif %}
            >
              {{- ' (' -}}
              <span ref="quantityNumber">{{- initial_quantity -}}</span>
              {{- ')' -}}
            </span>
          </span>
        </span>
        <span class="add-to-cart__added">
          <span class="svg-wrapper add-to-cart__added-icon">
            {{- 'icon-checkmark-burst.svg' | inline_asset_content -}}
          </span>
        </span>
      </button>
    </div>
  </sticky-add-to-cart>
{% endif %}

