    settings: section.settings,
    media_gallery: media_gallery,
    product_details: product_details,
    additional_blocks: additional_blocks
  %}

  {% if show_mobile_customize %}
    <div class="premium-trucker-product__mobile-sticky-customize" aria-label="Product customizer">
      <button
        type="button"
        class="premium-trucker-product__customize-button premium-trucker-product__mobile-sticky-customize-button"
        data-pitchprint-customize-trigger
        data-mobile-pitchprint-customize-trigger
