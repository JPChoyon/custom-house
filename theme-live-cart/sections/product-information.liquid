  {% endif %}
  style="
    --ptp-page-bg: {{ section.settings.premium_background_color }};
    --ptp-panel-bg: {{ section.settings.premium_panel_color }};
    --ptp-text: {{ section.settings.premium_text_color }};
    --ptp-muted: {{ section.settings.premium_muted_color }};
    --ptp-border: {{ section.settings.premium_border_color }};
    --ptp-accent: {{ section.settings.premium_accent_color }};
    --ptp-accent-2: {{ section.settings.premium_accent_2_color }};
    --ptp-service: {{ section.settings.service_icon_color }};
    --ptp-max-width: {{ section.settings.premium_max_width }}px;
    --ptp-side-padding: {{ section.settings.premium_side_padding }}px;
    --ptp-mobile-padding: {{ section.settings.premium_mobile_padding }}px;
    --ptp-grid-gap: {{ section.settings.premium_grid_gap }}px;
    --ptp-media-radius: {{ section.settings.premium_media_radius }}px;
    --ptp-button-radius: {{ section.settings.premium_button_radius }}px;
    --ptp-thumbnail-size: {{ section.settings.premium_thumbnail_size }}px;
    --ptp-thumbnail-display-size: clamp(116px, calc(var(--ptp-thumbnail-size) + 20px), 150px);
    --ptp-heading-size: {{ section.settings.premium_heading_size }}px;
    --ptp-heading-size-mobile: {{ section.settings.premium_heading_size_mobile }}px;
    --ptp-gallery-object-fit: {{ section.settings.custom_gallery_image_fit }};
