<script>
  (() => {
    const root = document.getElementById('same-related-{{ section.id }}');
    if (!root) return;

    const setupSlider = () => {
      if (root.dataset.enableSlider !== 'true') return;

      const viewport = root.querySelector('.same-related__viewport');
      const track = root.querySelector('.same-related__grid');
      const cards = Array.from(root.querySelectorAll('.same-related-card'));
      const prev = root.querySelector('.same-related__arrow--prev');
      const next = root.querySelector('.same-related__arrow--next');
      const dots = root.querySelector('.same-related__dots');
      if (!viewport || !track || !cards.length || !prev || !next || !dots) return;

      let index = 0;
      let maxIndex = 0;

      const cardsPerView = () => {
        const viewportWidth = viewport.getBoundingClientRect().width;
        const cardWidth = cards[0].getBoundingClientRect().width;
        const gap = parseFloat(getComputedStyle(track).gap) || 0;
        return Math.max(1, Math.floor((viewportWidth + gap) / (cardWidth + gap)));
      };

      const buildDots = () => {
        dots.innerHTML = '';
        for (let i = 0; i <= maxIndex; i += 1) {
          const dot = document.createElement('button');
          dot.type = 'button';
          dot.className = 'same-related__dot';
          dot.setAttribute('aria-label', `Go to slide ${i + 1}`);
          dot.addEventListener('click', () => {
            index = i;
            update();
          });
          dots.appendChild(dot);
        }
      };

      const update = () => {
        const gap = parseFloat(getComputedStyle(track).gap) || 0;
        const cardWidth = cards[0].getBoundingClientRect().width;
        maxIndex = Math.max(0, cards.length - cardsPerView());
        index = Math.min(index, maxIndex);
        track.style.transform = `translateX(${-index * (cardWidth + gap)}px)`;
        prev.disabled = index === 0;
        next.disabled = index === maxIndex;
        Array.from(dots.children).forEach((dot, dotIndex) => {
          dot.classList.toggle('is-active', dotIndex === index);
        });
      };

      const refresh = () => {
        const nextMax = Math.max(0, cards.length - cardsPerView());
        if (nextMax !== maxIndex || dots.children.length !== nextMax + 1) {
          maxIndex = nextMax;
          buildDots();
        }
        update();
      };

      prev.addEventListener('click', () => {
        index = Math.max(0, index - 1);
        update();
      });

      next.addEventListener('click', () => {
        index = Math.min(maxIndex, index + 1);
        update();
      });

      let resizeTimer;
      window.addEventListener('resize', () => {
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(refresh, 120);
      });

      refresh();
    };

    setupSlider();

    const recommendations = root.querySelector('same-product-recommendations');
    if (recommendations && recommendations.dataset.url && recommendations.dataset.loaded !== 'true') {
      recommendations.dataset.loaded = 'true';
      fetch(recommendations.dataset.url)
        .then((response) => response.text())
        .then((text) => {
          const html = document.createElement('div');
          html.innerHTML = text;
          const fresh = html.querySelector('same-product-recommendations');
          if (fresh && fresh.innerHTML.trim().length) {
            recommendations.innerHTML = fresh.innerHTML;
            setupSlider();
          }
        })
        .catch(() => {
          recommendations.innerHTML = '';
        });
    }

    document.addEventListener('shopify:section:load', (event) => {
      if (event.detail && event.detail.sectionId === '{{ section.id }}') setupSlider();
    });
  })();
</script>

