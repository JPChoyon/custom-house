{% comment %}
  Same To Same Related Products
  Add this file to your Shopify theme at: sections/same-to-same-related-products.liquid
{% endcomment %}

{%- liquid
  assign section_title = section.settings.heading | default: 'More From Marcus'
  assign title_parts = section_title | split: '|'
  assign title_main = title_parts[0] | strip
  assign title_accent = title_parts[1] | strip
  assign product_limit = section.settings.products_to_show
  assign source_products = blank
  assign desktop_gap_total = section.settings.columns_desktop | minus: 1 | times: 28
  assign tablet_gap_total = section.settings.columns_tablet | minus: 1 | times: 20
  assign mobile_gap_total = section.settings.columns_mobile | minus: 1 | times: 16

  if section.settings.product_source == 'collection' and section.settings.collection != blank
    assign source_products = section.settings.collection.products
  elsif section.settings.product_source == 'manual'
    assign source_products = section.settings.product_list
  elsif product != blank and section.settings.product_source == 'same_collection' and product.collections.first != blank
    assign source_products = product.collections.first.products
  endif
-%}

<section
  id="same-related-{{ section.id }}"
  class="same-related color-{{ section.id }}"
  data-section-id="{{ section.id }}"
  data-enable-slider="{{ section.settings.enable_slider }}"
  style="
    --same-bg: {{ section.settings.background_color }};
    --same-panel-bg: {{ section.settings.panel_background_color }};
    --same-text: {{ section.settings.text_color }};
    --same-muted: {{ section.settings.muted_text_color }};
    --same-purple: {{ section.settings.primary_color }};
    --same-lime: {{ section.settings.accent_color }};
    --same-card-bg: {{ section.settings.card_background_color }};
    --same-border: {{ section.settings.border_color }};
    --same-radius: {{ section.settings.border_radius }}px;
    --same-card-radius: {{ section.settings.card_radius }}px;
    --same-heading-max: {{ section.settings.heading_max_width }}px;
    --same-top: {{ section.settings.padding_top }}px;
    --same-bottom: {{ section.settings.padding_bottom }}px;
    --same-max: {{ section.settings.max_width }}px;
    --same-cols-desktop: {{ section.settings.columns_desktop }};
    --same-cols-tablet: {{ section.settings.columns_tablet }};
    --same-cols-mobile: {{ section.settings.columns_mobile }};
  "
>
  <div class="same-related__wrap">
    <div class="same-related__panel">
      {%- if section.settings.background_image != blank -%}
        <div
          class="same-related__bg-image"
          style="background-image: url({{ section.settings.background_image | image_url: width: 2400 }}); opacity: {{ section.settings.background_image_opacity | divided_by: 100.0 }};"
          aria-hidden="true"
        ></div>
      {%- endif -%}

      {%- if section.settings.show_decorations -%}
        <div class="same-related__mark same-related__mark--left" aria-hidden="true">
          {%- if section.settings.left_decor_image != blank -%}
            {{ section.settings.left_decor_image | image_url: width: 520 | image_tag: loading: 'lazy', class: 'same-related__decor-img', alt: '' }}
          {%- else -%}
            X
          {%- endif -%}
        </div>
        <div class="same-related__mark same-related__mark--right" aria-hidden="true">
          {%- if section.settings.right_decor_image != blank -%}
            {{ section.settings.right_decor_image | image_url: width: 420 | image_tag: loading: 'lazy', class: 'same-related__decor-img', alt: '' }}
          {%- else -%}
            M
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="same-related__header">
        {%- if section.settings.show_crown -%}
          <span class="same-related__crown" aria-hidden="true">
            <svg viewBox="0 0 48 40" role="presentation" focusable="false">
              <path d="M5 32 9 10l11 12L24 5l4 17 11-12 4 22H5Z" fill="none" stroke="currentColor" stroke-width="4" stroke-linejoin="round"/>
              <path d="M7 35h34" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round"/>
            </svg>
          </span>
        {%- endif -%}

        <h2 class="same-related__title">
          <span class="same-related__rule" aria-hidden="true"></span>
          <span>{{ title_main | escape }}</span>
          {%- if title_accent != blank -%}
            <span class="same-related__accent">{{ title_accent | escape }}</span>
          {%- endif -%}
          <span class="same-related__rule" aria-hidden="true"></span>
        </h2>

        {%- if section.settings.subheading != blank -%}
          <p class="same-related__subtitle">{{ section.settings.subheading | escape }}</p>
        {%- endif -%}
      </div>

      {%- if section.settings.product_source == 'recommendations' and product != blank -%}
        <same-product-recommendations
          class="same-related__recommendations"
          data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ product_limit }}&intent=related"
        >
          {%- if recommendations.performed and recommendations.products_count > 0 -%}
            <div class="same-related__viewport">
              <div class="same-related__grid" role="list">
                {%- for related_product in recommendations.products limit: product_limit -%}
                  <article class="same-related-card" role="listitem">
                    <a class="same-related-card__media" href="{{ related_product.url }}" aria-label="{{ related_product.title | escape }}">
                      {%- if related_product.featured_media != blank -%}
                        {{
                          related_product.featured_media
                          | image_url: width: 900
                          | image_tag:
                            loading: 'lazy',
                            sizes: '(min-width: 990px) 25vw, (min-width: 750px) 45vw, 82vw',
                            widths: '300, 450, 600, 750, 900',
                            class: 'same-related-card__image',
                            alt: related_product.featured_media.alt | escape
                        }}
                      {%- else -%}
                        {{ 'product-1' | placeholder_svg_tag: 'same-related-card__placeholder' }}
                      {%- endif -%}
                    </a>

                    {%- if section.settings.show_wishlist -%}
                      <button class="same-related-card__heart" type="button" aria-label="{{ section.settings.wishlist_label | escape }}">
                        <svg viewBox="0 0 24 24" role="presentation" focusable="false">
                          <path d="M12 21s-7.2-4.3-9.4-9.1C.9 8.1 3.1 4 7 4c2.1 0 3.6 1 5 3 1.4-2 2.9-3 5-3 3.9 0 6.1 4.1 4.4 7.9C19.2 16.7 12 21 12 21Z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
                        </svg>
                      </button>
                    {%- endif -%}

                    <div class="same-related-card__body">
                      {%- if section.settings.show_vendor and related_product.vendor != blank -%}
                        <p class="same-related-card__vendor">{{ related_product.vendor | escape }}</p>
                      {%- endif -%}

                      <h3 class="same-related-card__title">
                        <a href="{{ related_product.url }}">{{ related_product.title | escape }}</a>
                      </h3>

                      <div class="same-related-card__meta">
                        {%- if section.settings.show_rating -%}
                          {%- liquid
                            assign rating = related_product.metafields.reviews.rating.value.rating | default: related_product.metafields.reviews.rating.value | default: section.settings.fallback_rating
                            assign rating_count = related_product.metafields.reviews.rating_count.value | default: section.settings.fallback_rating_count
                          -%}
                          <span class="same-related-card__rating">
                            <svg viewBox="0 0 20 20" role="presentation" focusable="false">
                              <path d="m10 1.7 2.5 5.2 5.7.8-4.1 4 1 5.7-5.1-2.7-5.1 2.7 1-5.7-4.1-4 5.7-.8L10 1.7Z" fill="currentColor"/>
                            </svg>
                            <span>{{ rating }}</span>
                            {%- if rating_count != blank -%}
                              <span>({{ rating_count }})</span>
                            {%- endif -%}
                          </span>
                        {%- endif -%}

                        {%- if section.settings.show_price -%}
                          <span class="same-related-card__price">
                            {%- if related_product.price_varies -%}
                              {{ section.settings.from_text | escape }} {{ related_product.price_min | money }}
                            {%- else -%}
                              {{ related_product.price | money }}
                            {%- endif -%}
                          </span>
                        {%- endif -%}
                      </div>

                      {%- if section.settings.show_button -%}
                        <a class="same-related-card__button" href="{{ related_product.url }}">
                          {{ section.settings.button_label | escape }}
                        </a>
                      {%- endif -%}
                    </div>
                  </article>
                {%- endfor -%}
              </div>
            </div>
          {%- else -%}
            <div class="same-related__loading" aria-live="polite">{{ section.settings.loading_text | escape }}</div>
          {%- endif -%}
        </same-product-recommendations>
      {%- else -%}
        <div class="same-related__viewport">
          <div class="same-related__grid" role="list">
            {%- if source_products != blank -%}
              {%- for related_product in source_products limit: product_limit -%}
                {%- unless related_product.id == product.id -%}
                  <article class="same-related-card" role="listitem">
                    <a class="same-related-card__media" href="{{ related_product.url }}" aria-label="{{ related_product.title | escape }}">
                      {%- if related_product.featured_media != blank -%}
                        {{
                          related_product.featured_media
                          | image_url: width: 900
                          | image_tag:
                            loading: 'lazy',
                            sizes: '(min-width: 990px) 25vw, (min-width: 750px) 45vw, 82vw',
                            widths: '300, 450, 600, 750, 900',
                            class: 'same-related-card__image',
                            alt: related_product.featured_media.alt | escape
                        }}
                      {%- else -%}
                        {{ 'product-1' | placeholder_svg_tag: 'same-related-card__placeholder' }}
                      {%- endif -%}
                    </a>

                    {%- if section.settings.show_wishlist -%}
                      <button class="same-related-card__heart" type="button" aria-label="{{ section.settings.wishlist_label | escape }}">
                        <svg viewBox="0 0 24 24" role="presentation" focusable="false">
                          <path d="M12 21s-7.2-4.3-9.4-9.1C.9 8.1 3.1 4 7 4c2.1 0 3.6 1 5 3 1.4-2 2.9-3 5-3 3.9 0 6.1 4.1 4.4 7.9C19.2 16.7 12 21 12 21Z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
                        </svg>
                      </button>
                    {%- endif -%}

                    <div class="same-related-card__body">
                      {%- if section.settings.show_vendor and related_product.vendor != blank -%}
                        <p class="same-related-card__vendor">{{ related_product.vendor | escape }}</p>
                      {%- endif -%}

                      <h3 class="same-related-card__title">
                        <a href="{{ related_product.url }}">{{ related_product.title | escape }}</a>
                      </h3>

                      <div class="same-related-card__meta">
                        {%- if section.settings.show_rating -%}
                          {%- liquid
                            assign rating = related_product.metafields.reviews.rating.value.rating | default: related_product.metafields.reviews.rating.value | default: section.settings.fallback_rating
                            assign rating_count = related_product.metafields.reviews.rating_count.value | default: section.settings.fallback_rating_count
                          -%}
                          <span class="same-related-card__rating">
                            <svg viewBox="0 0 20 20" role="presentation" focusable="false">
                              <path d="m10 1.7 2.5 5.2 5.7.8-4.1 4 1 5.7-5.1-2.7-5.1 2.7 1-5.7-4.1-4 5.7-.8L10 1.7Z" fill="currentColor"/>
                            </svg>
                            <span>{{ rating }}</span>
                            {%- if rating_count != blank -%}
                              <span>({{ rating_count }})</span>
                            {%- endif -%}
                          </span>
                        {%- endif -%}

                        {%- if section.settings.show_price -%}
                          <span class="same-related-card__price">
                            {%- if related_product.price_varies -%}
                              {{ section.settings.from_text | escape }} {{ related_product.price_min | money }}
                            {%- else -%}
                              {{ related_product.price | money }}
                            {%- endif -%}
                          </span>
                        {%- endif -%}
                      </div>

                      {%- if section.settings.show_button -%}
                        <a class="same-related-card__button" href="{{ related_product.url }}">
                          {{ section.settings.button_label | escape }}
                        </a>
                      {%- endif -%}
                    </div>
                  </article>
                {%- endunless -%}
              {%- endfor -%}
            {%- endif -%}
          </div>
        </div>
      {%- endif -%}

      {%- if section.settings.enable_slider -%}
        <div class="same-related__controls" aria-label="{{ section.settings.slider_controls_label | escape }}">
          <button class="same-related__arrow same-related__arrow--prev" type="button" aria-label="{{ section.settings.previous_label | escape }}">
            <svg viewBox="0 0 24 24" role="presentation" focusable="false">
              <path d="M15 18 9 12l6-6" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M20 12H9" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/>
            </svg>
          </button>
          <div class="same-related__dots" aria-hidden="true"></div>
          <button class="same-related__arrow same-related__arrow--next" type="button" aria-label="{{ section.settings.next_label | escape }}">
            <svg viewBox="0 0 24 24" role="presentation" focusable="false">
              <path d="m9 18 6-6-6-6" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M4 12h11" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/>
            </svg>
          </button>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% style %}
  #same-related-{{ section.id }} {
    background: var(--same-bg);
    color: var(--same-text);
    padding-block: var(--same-top) var(--same-bottom);
    overflow: hidden;
  }

  #same-related-{{ section.id }} .same-related__wrap {
    width: min(100%, var(--same-max));
    margin-inline: auto;
    padding-inline: clamp(14px, 3vw, 28px);
  }

  #same-related-{{ section.id }} .same-related__panel {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--same-border) 76%, transparent);
    border-radius: var(--same-radius);
    background:
      radial-gradient(circle at 20% 15%, color-mix(in srgb, var(--same-purple) 18%, transparent) 0 2px, transparent 3px),
      radial-gradient(circle at 88% 28%, color-mix(in srgb, var(--same-lime) 12%, transparent), transparent 20%),
      linear-gradient(180deg, color-mix(in srgb, var(--same-panel-bg) 90%, #151018), var(--same-panel-bg));
    box-shadow:
      inset 0 0 0 1px color-mix(in srgb, var(--same-purple) 18%, transparent),
      0 0 34px color-mix(in srgb, var(--same-purple) 18%, transparent);
    padding: clamp(28px, 4vw, 56px) clamp(14px, 3.7vw, 56px) clamp(22px, 3.6vw, 40px);
  }

  #same-related-{{ section.id }} .same-related__bg-image,
  #same-related-{{ section.id }} .same-related__mark {
    position: absolute;
    pointer-events: none;
    user-select: none;
    z-index: -1;
  }

  #same-related-{{ section.id }} .same-related__bg-image {
    inset: 0;
    background-position: center;
    background-size: cover;
  }

  #same-related-{{ section.id }} .same-related__mark {
    color: color-mix(in srgb, var(--same-purple) 34%, transparent);
    font-family: Impact, Haettenschweiler, 'Arial Narrow Bold', sans-serif;
    font-size: clamp(160px, 22vw, 330px);
    line-height: .75;
    opacity: {{ section.settings.decor_opacity | divided_by: 100.0 }};
    filter: blur(.15px);
    transform: rotate(-14deg) skew(-7deg);
    text-shadow:
      -10px 12px 0 color-mix(in srgb, var(--same-purple) 18%, transparent),
      18px -6px 0 color-mix(in srgb, var(--same-purple) 10%, transparent);
  }

  #same-related-{{ section.id }} .same-related__mark--left {
    left: clamp(-88px, -5vw, -32px);
    top: clamp(-22px, -1vw, 12px);
  }

  #same-related-{{ section.id }} .same-related__mark--right {
    right: clamp(-58px, -3vw, -18px);
    top: clamp(22px, 4vw, 48px);
    transform: rotate(5deg) skew(-5deg);
  }

  #same-related-{{ section.id }} .same-related__decor-img {
    width: min(34vw, 360px);
    height: auto;
    object-fit: contain;
  }

  #same-related-{{ section.id }} .same-related__header {
    text-align: center;
    max-width: var(--same-heading-max);
    margin: 0 auto clamp(24px, 3vw, 44px);
  }

  #same-related-{{ section.id }} .same-related__crown {
    display: inline-grid;
    place-items: center;
    width: clamp(24px, 3vw, 38px);
    color: var(--same-purple);
    margin-bottom: 8px;
  }

  #same-related-{{ section.id }} .same-related__crown svg,
  #same-related-{{ section.id }} .same-related__arrow svg,
  #same-related-{{ section.id }} .same-related-card__heart svg,
  #same-related-{{ section.id }} .same-related-card__rating svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  #same-related-{{ section.id }} .same-related__title {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(10px, 2vw, 22px);
    margin: 0;
    color: var(--same-text);
    font-family: {{ section.settings.heading_font.family }}, {{ section.settings.heading_font.fallback_families }};
    font-style: {{ section.settings.heading_font.style }};
    font-weight: {{ section.settings.heading_font.weight }};
    font-size: clamp({{ section.settings.heading_size_mobile }}px, 3.2vw, {{ section.settings.heading_size_desktop }}px);
    line-height: 1.05;
    letter-spacing: 0;
    text-transform: {{ section.settings.heading_transform }};
  }

  {{ section.settings.heading_font | font_face: font_display: 'swap' }}

  #same-related-{{ section.id }} .same-related__accent {
    color: var(--same-lime);
  }

  #same-related-{{ section.id }} .same-related__rule {
    display: block;
    width: clamp(28px, 5vw, 56px);
    height: 2px;
    background: var(--same-purple);
    box-shadow: 0 0 10px color-mix(in srgb, var(--same-purple) 70%, transparent);
  }

  #same-related-{{ section.id }} .same-related__subtitle,
  #same-related-{{ section.id }} .same-related__loading {
    margin: 12px 0 0;
    color: var(--same-muted);
    font-size: clamp(14px, 1.4vw, 18px);
    line-height: 1.45;
  }

  #same-related-{{ section.id }} .same-related__viewport {
    overflow: hidden;
  }

  #same-related-{{ section.id }} .same-related__grid {
    display: grid;
    grid-template-columns: repeat(var(--same-cols-desktop), minmax(0, 1fr));
    gap: 28px;
    transition: transform .38s ease;
    will-change: transform;
  }

  #same-related-{{ section.id }}[data-enable-slider="true"] .same-related__grid {
    display: flex;
    gap: 28px;
  }

  #same-related-{{ section.id }}[data-enable-slider="true"] .same-related-card {
    flex: 0 0 calc((100% - {{ desktop_gap_total }}px) / {{ section.settings.columns_desktop }});
  }

  #same-related-{{ section.id }} .same-related-card {
    position: relative;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--same-border) 78%, transparent);
    border-radius: var(--same-card-radius);
    background:
      linear-gradient(180deg, color-mix(in srgb, var(--same-card-bg) 96%, #21132c), var(--same-card-bg));
    box-shadow:
      inset 0 0 0 1px color-mix(in srgb, var(--same-purple) 12%, transparent),
      0 12px 28px rgb(0 0 0 / 30%);
    min-width: 0;
  }

  #same-related-{{ section.id }} .same-related-card__media {
    position: relative;
    display: block;
    aspect-ratio: {{ section.settings.image_ratio }};
    overflow: hidden;
    background:
      radial-gradient(circle at 20% 20%, color-mix(in srgb, var(--same-purple) 28%, transparent), transparent 36%),
      radial-gradient(circle at 82% 18%, color-mix(in srgb, var(--same-lime) 16%, transparent), transparent 24%),
      #120f16;
  }

  #same-related-{{ section.id }} .same-related-card__media::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(135deg, transparent 42%, color-mix(in srgb, var(--same-purple) 20%, transparent) 42% 48%, transparent 48%),
      radial-gradient(circle at 10% 100%, color-mix(in srgb, var(--same-purple) 20%, transparent), transparent 28%);
    mix-blend-mode: screen;
    opacity: {{ section.settings.card_texture_opacity | divided_by: 100.0 }};
  }

  #same-related-{{ section.id }} .same-related-card__image,
  #same-related-{{ section.id }} .same-related-card__placeholder {
    width: 100%;
    height: 100%;
    object-fit: {{ section.settings.image_fit }};
    display: block;
    transition: transform .35s ease, filter .35s ease;
  }

  #same-related-{{ section.id }} .same-related-card:hover .same-related-card__image {
    transform: scale(1.035);
    filter: contrast(1.06);
  }

  #same-related-{{ section.id }} .same-related-card__heart {
    position: absolute;
    top: 14px;
    right: 14px;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    padding: 0;
    border: 2px solid color-mix(in srgb, var(--same-purple) 72%, transparent);
    border-radius: 999px;
    color: var(--same-purple);
    background: rgb(8 7 12 / 52%);
    box-shadow: 0 0 16px color-mix(in srgb, var(--same-purple) 22%, transparent);
    cursor: pointer;
  }

  #same-related-{{ section.id }} .same-related-card__heart svg {
    width: 22px;
    height: 22px;
  }

  #same-related-{{ section.id }} .same-related-card__body {
    padding: clamp(14px, 1.9vw, 20px);
  }

  #same-related-{{ section.id }} .same-related-card__vendor {
    margin: 0 0 6px;
    color: var(--same-muted);
    font-size: 12px;
    line-height: 1.2;
    text-transform: uppercase;
  }

  #same-related-{{ section.id }} .same-related-card__title {
    margin: 0 0 12px;
    color: var(--same-text);
    font-size: clamp(15px, 1.5vw, 18px);
    line-height: 1.2;
    font-weight: 800;
    letter-spacing: 0;
  }

  #same-related-{{ section.id }} .same-related-card__title a,
  #same-related-{{ section.id }} .same-related-card__button {
    color: inherit;
    text-decoration: none;
  }

  #same-related-{{ section.id }} .same-related-card__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 18px;
  }

  #same-related-{{ section.id }} .same-related-card__rating {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-width: 0;
    color: var(--same-muted);
    font-size: 14px;
    line-height: 1;
    white-space: nowrap;
  }

  #same-related-{{ section.id }} .same-related-card__rating svg {
    width: 18px;
    height: 18px;
    color: var(--same-purple);
    flex: 0 0 auto;
  }

  #same-related-{{ section.id }} .same-related-card__price {
    color: var(--same-lime);
    font-size: clamp(14px, 1.3vw, 17px);
    line-height: 1;
    font-weight: 900;
    white-space: nowrap;
  }

  #same-related-{{ section.id }} .same-related-card__button {
    display: grid;
