      object-position: var(--customhouse-image-x-mobile) var(--customhouse-image-y-mobile);
    }

    .customhouse-hero__copy {
      left: var(--customhouse-copy-left-mobile);
      top: var(--customhouse-copy-top-mobile);
      width: min(var(--customhouse-copy-width-mobile), calc(100% - var(--customhouse-copy-left-mobile) - 18px));
