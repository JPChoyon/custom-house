      "default": "#C6C6CC"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#D7FF2F"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "default": "#6D42B8"
    },
    {
      "type": "header",
      "content": "Background detail"
    },
    {
      "type": "checkbox",
      "id": "enable_graffiti_accents",
      "label": "Enable graffiti accents",
      "default": true
    },
    {
      "type": "range",
      "id": "texture_opacity",
      "label": "Concrete texture opacity",
      "min": 0,
      "max": 100,
