    opacity: 1 !important;
  }

  #ProductInformation-{{ section.id }} .marked-size-guide-modal[hidden] {
    display: none !important;
  }

  #ProductInformation-{{ section.id }} .marked-size-guide-modal {
    position: fixed !important;
