  }

  #ProductInformation-{{ section.id }} .marked-size-guide-modal__header {
    display: flex !important;
    align-items: center !important;
    justify-content: space-between !important;
    gap: 16px !important;
    border-bottom: 1px solid rgba(255, 255, 255, 0.12) !important;
    padding: 16px 18px !important;
  }

  #ProductInformation-{{ section.id }} .marked-size-guide-modal__header h2 {
    margin: 0 !important;
    font-size: 18px !important;
    font-weight: 800 !important;
    line-height: 1.2 !important;
  }

  #ProductInformation-{{ section.id }} .marked-size-guide-modal__close {
    display: inline-flex !important;
    width: 34px !important;
    height: 34px !important;
    align-items: center !important;
    justify-content: center !important;
    border: 1px solid rgba(255, 255, 255, 0.16) !important;
    border-radius: 8px !important;
    padding: 0 !important;
    background: rgba(255, 255, 255, 0.06) !important;
    color: #fff !important;
    font-size: 22px !important;
    line-height: 1 !important;
    cursor: pointer !important;
  }

  #ProductInformation-{{ section.id }} .marked-size-guide-modal__body {
    padding: 18px !important;
  }

  #ProductInformation-{{ section.id }} .marked-size-guide-modal__body p {
    margin: 0 0 14px !important;
    color: rgba(255, 255, 255, 0.72) !important;
    font-size: 13px !important;
    line-height: 1.4 !important;
  }

  #ProductInformation-{{ section.id }} .marked-size-guide-modal__table-wrap {
    width: 100% !important;
    overflow-x: auto !important;
  }

  #ProductInformation-{{ section.id }} .marked-size-guide-modal__table {
    width: 100% !important;
    border-collapse: collapse !important;
    min-width: 420px !important;
  }

  #ProductInformation-{{ section.id }} .marked-size-guide-modal__table th,
  #ProductInformation-{{ section.id }} .marked-size-guide-modal__table td {
    border: 1px solid rgba(255, 255, 255, 0.12) !important;
    padding: 11px 12px !important;
    text-align: left !important;
    font-size: 13px !important;
  }

  #ProductInformation-{{ section.id }} .marked-size-guide-modal__table th {
    background: rgba(145, 42, 255, 0.18) !important;
    color: #fff !important;
    font-weight: 800 !important;
    text-transform: uppercase !important;
  }

  #ProductInformation-{{ section.id }} .marked-size-guide-modal__table td:first-child {
    color: #b76cff !important;
    font-weight: 800 !important;
  }

  #ProductInformation-{{ section.id }} .marked-product-form {
    display: flex !important;
    width: 100% !important;
    min-width: 100% !important;
    max-width: none !important;
    flex-direction: column !important;
    gap: 10px !important;
  }

  #ProductInformation-{{ section.id }} .marked-product-actions__block--options {
    margin: 2px 0 8px !important;
  }

  #ProductInformation-{{ section.id }} .marked-product-actions__options,
  #ProductInformation-{{ section.id }} #INKYBAY_PRODUCT_OPTION_DIV,
  #ProductInformation-{{ section.id }} [id^='INKYBAY_OPTION_SET_'] {
    display: block !important;
    width: 100% !important;
    max-width: none !important;
    margin: 0 !important;
    background: transparent !important;
    color: currentColor !important;
  }

  #ProductInformation-{{ section.id }} .marked-product-actions__options label,
  #ProductInformation-{{ section.id }} .marked-product-actions__options legend,
  #ProductInformation-{{ section.id }} .marked-product-actions__options p,
  #ProductInformation-{{ section.id }} .marked-product-actions__options span {
    color: currentColor !important;
    font-family: inherit !important;
  }

  #ProductInformation-{{ section.id }} .marked-product-actions__options input:not([type='checkbox']):not([type='radio']):not([type='file']),
  #ProductInformation-{{ section.id }} .marked-product-actions__options select,
  #ProductInformation-{{ section.id }} .marked-product-actions__options textarea {
    width: 100% !important;
    min-height: 42px !important;
    border: 1px solid rgba(255, 255, 255, 0.18) !important;
    border-radius: 8px !important;
    background: rgba(255, 255, 255, 0.06) !important;
    color: currentColor !important;
    font-family: inherit !important;
  }

  #ProductInformation-{{ section.id }} .marked-product-actions__options input[type='file'] {
    width: 100% !important;
    color: currentColor !important;
