  }

  #ProductInformation-{{ section.id }} .marked-product-actions__color-swatch {
    display: inline-block !important;
    width: 40px !important;
    height: 40px !important;
    flex: 0 0 40px !important;
    border: 1px solid rgba(255, 255, 255, 0.3) !important;
    border-radius: 999px !important;
    background: var(--marked-color-swatch, #555) !important;
  }

  #ProductInformation-{{ section.id }} .marked-product-actions__size-row {
    display: flex !important;
    align-items: flex-start !important;
    justify-content: space-between !important;
    gap: 18px !important;
    margin-block-end: 18px !important;
  }

  #ProductInformation-{{ section.id }} .marked-product-actions__size-content {
    width: 100% !important;
    min-width: 0 !important;
  }

  #ProductInformation-{{ section.id }} .marked-product-actions__size-header {
    display: flex !important;
    width: 100% !important;
    align-items: center !important;
    justify-content: space-between !important;
    gap: 12px !important;
    margin-block-end: 8px !important;
  }

  #ProductInformation-{{ section.id }} .marked-product-actions__label {
    display: block !important;
    margin: 0 0 8px !important;
    font-size: 11px !important;
    font-weight: 700 !important;
    line-height: 1.2 !important;
    text-transform: uppercase !important;
    color: currentColor !important;
  }

  #ProductInformation-{{ section.id }} .marked-product-actions__size-header .marked-product-actions__label {
    margin: 0 !important;
  }

  #ProductInformation-{{ section.id }} .marked-product-actions__pills {
    display: flex !important;
    width: 100% !important;
    flex-wrap: wrap !important;
    gap: 8px !important;
  }

  #ProductInformation-{{ section.id }} .marked-product-actions__pill {
    display: inline-flex !important;
    min-width: 44px !important;
    min-height: 42px !important;
    align-items: center !important;
    justify-content: center !important;
    border: 1px solid rgba(145, 42, 255, 0.75) !important;
    border-radius: 8px !important;
    padding: 7px 14px !important;
    background: transparent !important;
    color: #9d4dff !important;
    font-size: 12px !important;
    font-weight: 700 !important;
    font-family: inherit !important;
    line-height: 1 !important;
    appearance: none !important;
    cursor: pointer !important;
  }

  #ProductInformation-{{ section.id }} .marked-product-actions__pill.is-active {
    border-color: #9b36ff !important;
    background: #7825e8 !important;
    color: #fff !important;
    box-shadow: 0 0 0 1px rgba(155, 54, 255, 0.45), 0 8px 18px rgba(120, 37, 232, 0.28) !important;
  }

  #ProductInformation-{{ section.id }} .marked-product-actions__guide {
