  #ProductInformation-{{ section.id }} > .group-block,
  #ProductInformation-{{ section.id }} .group-block,
  #ProductInformation-{{ section.id }} .group-block__content,
  #ProductInformation-{{ section.id }} .group-block-content {
    width: 100% !important;
    max-width: none !important;
    align-self: stretch !important;
    justify-self: stretch !important;
  }

  #ProductInformation-{{ section.id }} .marked-product-actions {
    width: 100% !important;
    min-width: 100% !important;
    max-width: none !important;
    flex: 1 1 100% !important;
    align-self: stretch !important;
    justify-self: stretch !important;
    margin-block-start: 0 !important;
    color: currentColor;
  }

  #ProductInformation-{{ section.id }} .marked-product-actions,
  #ProductInformation-{{ section.id }} .marked-product-actions * {
    box-sizing: border-box;
  }

  #ProductInformation-{{ section.id }} .marked-product-actions__block {
    display: block !important;
    width: 100% !important;
    min-width: 100% !important;
    max-width: none !important;
  }

  #ProductInformation-{{ section.id }} .marked-product-actions__block--size {
    margin-block-end: 0 !important;
  }

  #ProductInformation-{{ section.id }} .marked-product-actions__block--color {
    margin-block-end: 18px !important;
  }

  #ProductInformation-{{ section.id }} .marked-product-actions__color-header {
    display: flex !important;
    align-items: center !important;
    justify-content: flex-start !important;
    gap: 8px !important;
    margin-block-end: 10px !important;
  }

  #ProductInformation-{{ section.id }} .marked-product-actions__color-current {
    color: rgba(255, 255, 255, 0.68) !important;
    font-size: 11px !important;
    font-weight: 800 !important;
    line-height: 1 !important;
    text-transform: uppercase !important;
  }

  #ProductInformation-{{ section.id }} .marked-product-actions__color-pills {
