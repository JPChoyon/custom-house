{%- assign block_settings = block.settings -%}
<div
  id="ProductInformation-{{ section.id }}"
  class="
    product-details
    {% if block_settings.sticky_details_desktop %} sticky-content--desktop{% endif %}
    {% if block_settings.height == 'fill' -%} full-height--desktop{% endif -%}
  "
  style="--details-position: {{ block_settings.details_position }};"
  data-testid="product-information-details"
  {% if settings.transition_to_main_product %}
    data-view-transition-type="product-details"
  {% endif %}
>
  {% capture children %}
    <div class="view-product-title">
      <a
        href="{{ closest.product.selected_or_first_available_variant.url }}"
      >
        {{- closest.product.title }}
      </a>
    </div>
    {% content_for 'blocks' %}

    {%- liquid
      assign product = closest.product
      assign selected_variant = product.selected_or_first_available_variant | default: product.variants.first
      assign product_form_id = 'MarkedProductForm-' | append: section.id
      assign force_allow_purchase = section.settings.force_allow_purchase
      assign product_type = product.metafields.customhouse.product_type.value | downcase
      assign pitchprint_enabled = product.metafields.customhouse.pitchprint_enabled.value
      assign is_creator_fixed_product = false
      assign is_pitchprint_designlab_product = false
      assign is_pitchprint_required_product = false
      assign size_option = blank
      assign size_option_name = 'Size'
      assign size_option_position = 1
      assign selected_size_value = selected_variant.option1
      assign color_option = blank
      assign color_option_name = 'Color'
      assign color_option_position = 0
      assign selected_color_value = blank
      assign production_method_pricing = product.metafields.customhouse.production_method_pricing.value

      if product_type == 'creator_fixed' or product.tags contains 'creator-fixed'
        assign is_creator_fixed_product = true
      endif

      unless is_creator_fixed_product
        if product_type == 'global_customizable' and pitchprint_enabled == true
          assign is_pitchprint_designlab_product = true
        elsif product.tags contains 'pitchprint' or product.tags contains 'pitchprint-enabled'
          assign is_pitchprint_designlab_product = true
        elsif product.tags contains 'pitchprint-designlab' or product.tags contains 'pitchprint-options'
          assign is_pitchprint_designlab_product = true
        endif
      endunless

      if is_pitchprint_designlab_product and product.tags contains 'pitchprint-required'
        assign is_pitchprint_required_product = true
      endif

      for option in product.options_with_values
        assign option_name = option.name | downcase
        if option_name contains 'size'
          assign size_option = option
          assign size_option_name = option.name
          assign size_option_position = option.position
          break
        endif
      endfor

      for option in product.options_with_values
        assign option_name = option.name | downcase
        assign option_name_handle = option.name | handleize
        if option_name contains 'color' or option_name contains 'colour' or option_name_handle contains 'farg'
          assign color_option = option
          assign color_option_name = option.name
          assign color_option_position = option.position
          break
        endif
      endfor

      case size_option_position
        when 2
          assign selected_size_value = selected_variant.option2
        when 3
          assign selected_size_value = selected_variant.option3
        else
          assign selected_size_value = selected_variant.option1
      endcase

      case color_option_position
        when 1
          assign selected_color_value = selected_variant.option1
        when 2
          assign selected_color_value = selected_variant.option2
        when 3
          assign selected_color_value = selected_variant.option3
      endcase

    -%}

    <div
      class="marked-product-actions"
      data-marked-product-actions
      data-product-variants="{{ product.variants | json | escape }}"
      data-size-option-position="{{ size_option_position }}"
      data-color-option-position="{{ color_option_position }}"
      data-product-id="{{ product.id }}"
      data-product-handle="{{ product.handle | escape }}"
      data-product-title="{{ product.title | escape }}"
      data-currency="{{ cart.currency.iso_code | default: localization.country.currency.iso_code | default: shop.currency | escape }}"
      data-selected-color="{{ selected_color_value | escape }}"
      data-selected-size="{{ selected_size_value | escape }}"
      data-initial-variant-id="{{ selected_variant.id }}"
      data-initial-quantity="1"
      data-force-allow-purchase="{% if force_allow_purchase %}true{% else %}false{% endif %}"
      {% if is_pitchprint_required_product %}
        data-customhouse-pitchprint-required="true"
      {% endif %}
    >
      {%- if color_option != blank -%}
        <div class="marked-product-actions__block marked-product-actions__block--color">
          <div class="marked-product-actions__color-header">
            <p class="marked-product-actions__label">{{ color_option_name }}:</p>
            <strong class="marked-product-actions__color-current" data-color-option-current>
              {{ selected_color_value | default: color_option.values.first }}
            </strong>
          </div>
          <div class="marked-product-actions__color-pills" aria-label="{{ color_option_name }}">
            {%- for value in color_option.values -%}
              {%- liquid
                assign color_handle = value | handleize
                assign swatch_color = '#555555'
                case color_handle
                  when 'black', 'svart'
                    assign swatch_color = '#050505'
                  when 'white', 'vit'
                    assign swatch_color = '#f3f3f3'
                  when 'navy'
                    assign swatch_color = '#12243d'
                  when 'green', 'forest-green', 'dark-green', 'gron', 'morkgron'
                    assign swatch_color = '#156044'
                  when 'red', 'rod'
                    assign swatch_color = '#dd201c'
                  when 'blue', 'bla'
                    assign swatch_color = '#2457d6'
                  when 'purple', 'lila'
                    assign swatch_color = '#8a2cff'
                  when 'gray', 'grey', 'gra'
                    assign swatch_color = '#6f6f6f'
                  when 'charcoal'
                    assign swatch_color = '#282828'
                  when 'silver'
                    assign swatch_color = '#bfc2c5'
                  when 'gold', 'guld'
                    assign swatch_color = '#d4a640'
                  when 'yellow', 'gul'
                    assign swatch_color = '#f2cf28'
                  when 'orange'
                    assign swatch_color = '#e37822'
                  when 'brown', 'brun'
                    assign swatch_color = '#69452c'
                  when 'pink', 'rosa'
                    assign swatch_color = '#e66da3'
                endcase
              -%}
              <button
                class="marked-product-actions__color-pill{% if value == selected_color_value %} is-active{% endif %}"
                type="button"
                data-color-option-value="{{ value | escape }}"
                aria-pressed="{% if value == selected_color_value %}true{% else %}false{% endif %}"
                style="--marked-color-swatch: {{ swatch_color }};"
              >
                <span class="marked-product-actions__color-swatch" aria-hidden="true"></span>
                <span>{{ value }}</span>
              </button>
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}

      <div class="marked-product-actions__block marked-product-actions__block--size">
        <div class="marked-product-actions__size-row">
          <div class="marked-product-actions__size-content">
            <div class="marked-product-actions__size-header">
              <p class="marked-product-actions__label">{{ size_option_name }}:</p>
              <button class="marked-product-actions__guide" type="button" data-size-guide-open>
                <span aria-hidden="true">&#9776;</span>
                Size Guide
              </button>
            </div>
            <div class="marked-product-actions__pills" aria-label="{{ size_option_name }}">
              {%- if size_option != blank -%}
                {%- for value in size_option.values -%}
                  <button
                    class="marked-product-actions__pill{% if value == selected_size_value %} is-active{% endif %}"
                    type="button"
                    data-size-option-value="{{ value | escape }}"
                    aria-pressed="{% if value == selected_size_value %}true{% else %}false{% endif %}"
                  >
                    {{ value }}
                  </button>
                {%- endfor -%}
              {%- else -%}
                <button class="marked-product-actions__pill is-active" type="button" aria-pressed="true">One Size</button>
              {%- endif -%}
            </div>
          </div>
        </div>
      </div>

      {% form 'product', product, id: product_form_id, class: 'marked-product-form', novalidate: 'novalidate', data-customhouse-pitchprint-form: is_pitchprint_required_product %}
        <input
          type="hidden"
          name="id"
          value="{{ selected_variant.id }}"
          {% if force_allow_purchase == false and selected_variant.available == false %}
            disabled
          {% endif %}
        >

        <div class="marked-product-actions__block marked-product-actions__block--quantity">
          <label class="marked-product-actions__label" for="Quantity-{{ section.id }}">Quantity:</label>
          <div class="marked-product-actions__quantity">
            <button class="marked-product-actions__qty-button" type="button" data-quantity-minus aria-label="Decrease quantity">&minus;</button>
            <input
              id="Quantity-{{ section.id }}"
              class="marked-product-actions__qty-input"
              type="number"
              name="quantity"
              value="1"
              min="1"
              inputmode="numeric"
            >
            <button class="marked-product-actions__qty-button" type="button" data-quantity-plus aria-label="Increase quantity">+</button>
          </div>
        </div>

        <div class="marked-product-actions__block marked-product-actions__block--add">
          <button
            class="marked-product-actions__add"
            type="submit"
            name="add"
            data-add-to-cart-button
            {% if force_allow_purchase == false and selected_variant.available == false %}
              disabled
            {% endif %}
          >
            <span aria-hidden="true">&#128722;</span>
            <span data-add-to-cart-label>
              {%- if selected_variant.available or force_allow_purchase -%}
                Add to cart
              {%- else -%}
                Sold out
              {%- endif -%}
            </span>
          </button>
          <p class="marked-product-actions__cart-status" data-cart-status role="status" aria-live="polite" hidden></p>
        </div>

        <div class="marked-product-actions__block marked-product-actions__block--buy-now">
          <div class="marked-product-actions__buy-now">
            {{ form | payment_button }}
          </div>
        </div>
      {% endform %}

      {% if is_pitchprint_required_product and production_method_pricing != blank %}
        <script
          type="application/json"
          data-customhouse-production-pricing-json
        >
          {{ production_method_pricing | json }}
        </script>
      {% endif %}

    </div>

    <div
      id="MarkedSizeGuide-{{ section.id }}"
      class="marked-size-guide-modal"
      data-size-guide-modal
      aria-hidden="true"
      hidden
    >
      <div class="marked-size-guide-modal__backdrop" data-size-guide-close></div>
      <div class="marked-size-guide-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="MarkedSizeGuideTitle-{{ section.id }}">
        <div class="marked-size-guide-modal__header">
          <h2 id="MarkedSizeGuideTitle-{{ section.id }}">Size Guide</h2>
          <button class="marked-size-guide-modal__close" type="button" data-size-guide-close aria-label="Close size guide">&times;</button>
        </div>
        <div class="marked-size-guide-modal__body">
          <p>Approximate body measurements in inches.</p>
          <div class="marked-size-guide-modal__table-wrap">
            <table class="marked-size-guide-modal__table">
              <thead>
                <tr>
                  <th>Size</th>
                  <th>Chest</th>
                  <th>Length</th>
                  <th>Shoulder</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td>S</td>
                  <td>36-38</td>
                  <td>27</td>
                  <td>16.5</td>
                </tr>
                <tr>
                  <td>M</td>
                  <td>38-40</td>
                  <td>28</td>
                  <td>17</td>
                </tr>
                <tr>
                  <td>L</td>
                  <td>40-42</td>
                  <td>29</td>
                  <td>17.5</td>
                </tr>
                <tr>
                  <td>XL</td>
                  <td>42-44</td>
                  <td>30</td>
                  <td>18</td>
                </tr>
                <tr>
                  <td>2XL</td>
                  <td>44-46</td>
                  <td>31</td>
                  <td>18.5</td>
                </tr>
                <tr>
                  <td>3XL</td>
                  <td>46-48</td>
                  <td>32</td>
                  <td>19</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  {% endcapture %}

  {% render 'group',
    children: children,
    settings: block_settings,
    shopify_attributes: block.shopify_attributes,
    background_color: block_settings.background_color,
    block_id: block.id
  %}
</div>

<style>
