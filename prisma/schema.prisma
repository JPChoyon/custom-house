// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

enum CreatorStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum ReferralAttributionStatus {
  CAPTURED
  CONVERTED
}

enum ReferralEarningStatus {
  PENDING
  AVAILABLE
  PAID
  REVERSED
}

enum PayoutMethodType {
  PAYPAL
  BANK_TRANSFER
}

enum PayoutMethodStatus {
  PENDING_VERIFICATION
  VERIFIED
  DISABLED
}

enum PayoutStatus {
  REQUESTED
  APPROVED
  PROCESSING
  PAID
  REJECTED
  CANCELLED
  FAILED
}

enum PayoutAllocationSourceType {
  PRODUCT_EARNING
  REFERRAL_EARNING
}

enum PayoutExecutionMode {
  MANUAL
}

enum ApplicationStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
}

enum ApplicationSource {
  CUSTOM_APP
  HELIUM_IMPORT
}

enum StatusAuthority {
  HELIUM_IMPORT
  CUSTOM_APP
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
  PUBLISHING
  PUBLISHED
  FAILED
  ARCHIVED
}

enum DesignerMode {
  CUSTOMER_CUSTOMIZE
  CUSTOMER_BUY
  CREATOR_BUY
  CREATOR_PUBLISH
}

enum DesignProvider {
  FABRIC
  ZAKEKE
  INKYBAY
}

enum InkyBayPublishMode {
  MANUAL_BRIDGE
  INKYBAY_CALLBACK
}

enum DesignSessionStatus {
  CREATED
  DESIGNING
  WAITING_FOR_SAVED_DESIGN
  WAITING_FOR_ASSETS
  READY_TO_PUBLISH
  PUBLISHING
  DRAFT
  READY
  PUBLISHED
  CARTED
  FAILED
  EXPIRED
  CANCELLED
}

enum CreatorDesignStatus {
  DRAFT
  PROCESSING
  ACTIVE
  HIDDEN
  ARCHIVED
  SUSPENDED
  FAILED
}

enum CreatorProductStatus {
  DRAFT
  PENDING
  PUBLISHED
  REJECTED
  ARCHIVED
}

enum CreatorCollectionStatus {
  ACTIVE
  HIDDEN
  SUSPENDED
}

enum CreatorDesignSyncStatus {
  PENDING
  SYNCING
  SYNCED
  FAILED
  HIDDEN
}

enum GlobalProductMappingStatus {
  DRAFT
  TESTING
  ACTIVE
  DISABLED
  ERROR
}

enum DesignPurchaseStatus {
  CREATING
  READY
  CARTED
  ORDERED
  FAILED
  EXPIRED
}

enum PrintFilesStatus {
  PENDING
  PROCESSING
  AVAILABLE
  ERROR
  CANCELLED
  REFUNDED
}

enum WebhookDeliveryStatus {
  PROCESSING
  COMPLETED
  FAILED
}

enum ZakekeOrderJobStatus {
  PENDING
  PROCESSING
  REGISTERED
  FAILED
  CANCELLED
  REFUNDED
}

enum CreatorOrderProductionStatus {
  NEW
  READY_FOR_PRODUCTION
  IN_PRODUCTION
  FULFILLED
  CANCELLED
}

enum ProductionMethod {
  EMBROIDERY
  DTF
  DTG
}

model ShopConfig {
  id                                 String    @id @default(cuid())
  shop                               String    @unique
  creatorApplicationsEnabled         Boolean   @default(true)
  automaticCollectionCreationEnabled Boolean   @default(true)
  requireAdminApproval               Boolean   @default(true)
  collectionTitleTemplate            String    @default("{creatorName} Designs")
  collectionHandleSuffix             String    @default("designs")
  creatorTagsJson                    String    @default("{}")
  onlineStorePublicationId           String?
  creatorProfileMetaobjectType       String?
  creatorProfileFieldMapJson         String?
  heliumMetafieldMapJson             String?
  heliumCreatorFormId                String?
  referralEarningsLaunchAt           DateTime?
  minimumPayoutMinor                 BigInt    @default(0)
  allowReapplicationAfterRejection   Boolean   @default(false)
  heliumMigrationCompletedAt         DateTime?
  heliumDecommissionedAt             DateTime?
  creatorStatusMetafieldNamespace    String?
  creatorStatusMetafieldKey          String?
  inkybayAllowedHostsJson            String    @default("[]")
  inkybayBuyOnlyHiddenSelectorsJson  String    @default("[]")
  createdAt                          DateTime  @default(now())
  updatedAt                          DateTime  @updatedAt
}

model Creator {
  id                         String                @id @default(cuid())
  shop                       String
  customerId                 String
  displayName                String
  handle                     String
  referralCode               String
  referralCodeNormalized     String
  referredByCreatorId        String?
  emailSnapshot              String?
  bio                        String?
  portfolioUrl               String?
  profileImageUrl            String?
  socialLinksJson            String                @default("[]")
  legalName                  String?
  country                    String?
  city                       String?
  primaryPlatform            String?
  primaryProfileUrl          String?
  audienceRange              String?
  categoriesJson             String                @default("[]")
  aboutWork                  String?
  termsAcceptedAt            DateTime?
  applicationSource          ApplicationSource     @default(CUSTOM_APP)
  statusAuthority            StatusAuthority       @default(HELIUM_IMPORT)
  lastExternalSyncAt         DateTime?
  externalSnapshotHash       String?
  externalSyncConflict       Boolean               @default(false)
  status                     CreatorStatus         @default(PENDING)
  collectionId               String?
  creatorProfileMetaobjectId String?
  approvedAt                 DateTime?
  rejectedAt                 DateTime?
  submittedAt                DateTime?
  reviewedAt                 DateTime?
  suspendedAt                DateTime?
  rejectionReason            String?
  suspensionReason           String?
  createdAt                  DateTime              @default(now())
  updatedAt                  DateTime              @updatedAt
  applications               CreatorApplication[]
  submissions                DesignSubmission[]
  designSessions             DesignSession[]
  creatorDesigns             CreatorDesign[]
  creatorProducts            CreatorProduct[]
  marketplaceCollection      CreatorCollection?
  sales                      CreatorSale[]
  orderItems                 CreatorOrderItem[]
  referredByCreator          Creator?              @relation("CreatorReferralTree", fields: [referredByCreatorId], references: [id], onDelete: SetNull)
  referredCreators           Creator[]             @relation("CreatorReferralTree")
  referralAttributions       ReferralAttribution[] @relation("ReferralReferrer")
  referralEarningsEarned     ReferralEarning[]     @relation("ReferralEarningReferrer")
  referralEarningsGenerated  ReferralEarning[]     @relation("ReferralEarningReferred")
  payoutMethods              PayoutMethod[]
  payouts                    Payout[]

  @@unique([shop, customerId])
  @@unique([shop, handle])
  @@unique([shop, referralCodeNormalized])
  @@index([shop, status])
  @@index([shop, statusAuthority])
  @@index([referredByCreatorId])
}

model CreatorCollection {
  id                      String                  @id @default(cuid())
  shop                    String
  creatorId               String                  @unique
  publicId                String                  @unique @default(cuid())
  publicHandle            String                  @unique
  displayName             String
  status                  CreatorCollectionStatus @default(ACTIVE)
  bannerImageUrl          String?
  bannerTitle             String?
  bannerSubtitle          String?
  bannerUpdatedAt         DateTime?
  shopifyCollectionId     String?                 @unique
  shopifyCollectionHandle String?                 @unique
  shopifyCollectionUrl    String?
  shopifyPublishedAt      DateTime?
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  creator                 Creator                 @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@index([shop, status])
  @@index([shop, publicHandle])
}

model CreatorApplication {
  id                String            @id @default(cuid())
  shop              String
  shopifyCustomerId String?
  creatorId         String?
  answersJson       String
  legalName         String?
  displayName       String?
  emailSnapshot     String?
  country           String?
  city              String?
  bio               String?
  primaryPlatform   String?
  primaryProfileUrl String?
  audienceRange     String?
  categoriesJson    String            @default("[]")
  portfolioUrl      String?
  aboutWork         String?
  socialLinksJson   String            @default("[]")
  profileImageUrl   String?
  message           String?
  termsAcceptedAt   DateTime?
  submittedAt       DateTime?
  approvedAt        DateTime?
  rejectedAt        DateTime?
  rejectionReason   String?
  source            ApplicationSource @default(CUSTOM_APP)
  status            ApplicationStatus @default(PENDING)
  reviewerNote      String?
  reviewedAt        DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  creator           Creator?          @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@index([shop, status])
  @@index([shop, shopifyCustomerId])
  @@index([creatorId, createdAt])
}

model CreatorProduct {
  id                            String               @id @default(cuid())
  shop                          String
  creatorId                     String
  shopifyProductId              String
  shopifyProductHandle          String?
  baseProductTitle              String
  pitchprintProjectId           String?
  pitchprintDesignId            String?
  title                         String
  description                   String?
  previewUrl                    String?
  previewUrls                   String               @default("[]")
  baseProductVariantsJson       String               @default("[]")
  designVariantSelectionsJson   String               @default("[]")
  status                        CreatorProductStatus @default(DRAFT)
  publishedShopifyProductId     String?              @unique
  publishedShopifyProductHandle String?
  publishedShopifyProductUrl    String?
  shopifyPublishedAt            DateTime?
  baseVariantMappingJson        String               @default("{}")
  submittedAt                   DateTime?
  publishedAt                   DateTime?
  rejectedAt                    DateTime?
  rejectionReason               String?
  createdAt                     DateTime             @default(now())
  updatedAt                     DateTime             @updatedAt
  creator                       Creator              @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  orderItems                    CreatorOrderItem[]

  @@unique([shop, pitchprintProjectId])
  @@index([creatorId])
  @@index([creatorId, status])
  @@index([shop, shopifyProductId])
  @@index([shop, status])
  @@index([shop, status, submittedAt])
}

model DesignSubmission {
  id               String           @id @default(cuid())
  shop             String
  creatorId        String
  baseProductId    String
  baseVariantId    String?
  designName       String
  inkybayDesignId  String?
  savedDesignUrl   String
  previewUrl       String?
  creatorMessage   String?
  status           SubmissionStatus @default(PENDING)
  idempotencyKey   String
  createdProductId String?
  publishError     String?
  reviewedAt       DateTime?
  publishedAt      DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  creator          Creator          @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@unique([shop, idempotencyKey])
  @@index([shop, status])
  @@index([creatorId, createdAt])
  @@index([shop, createdProductId])
}

model DesignSession {
  id                     String                @id @default(cuid())
  shop                   String
  customerId             String
  creatorId              String?
  clientKey              String
  shopifyProductId       String
  shopifyVariantId       String
  mode                   DesignerMode
  provider               DesignProvider        @default(FABRIC)
  publishMode            InkyBayPublishMode?
  visitorCode            String?
  nonceHash              String?
  expiresAt              DateTime?
  zakekeDesignId         String?
  selectedAttributesJson String?
  globalProductMappingId String?
  designJson             String                @db.Text
  previewUrl             String?
  artworkUrl             String?
  productionArtworkKey   String?
  inkybaySavedDesignUrl  String?
  inkybayTid             String?
  title                  String?
  description            String?
  idempotencyKey         String?
  lastErrorCode          String?
  lastErrorReference     String?
  status                 DesignSessionStatus   @default(DRAFT)
  version                Int                   @default(1)
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  creator                Creator?              @relation(fields: [creatorId], references: [id], onDelete: SetNull)
  creatorDesign          CreatorDesign?
  globalProductMapping   GlobalProductMapping? @relation(fields: [globalProductMappingId], references: [id], onDelete: SetNull)

  @@unique([shop, customerId, clientKey])
  @@unique([shop, idempotencyKey])
  @@index([shop, customerId, updatedAt])
  @@index([creatorId, status])
  @@index([shop, provider, expiresAt])
  @@index([shop, provider, status, updatedAt])
  @@index([globalProductMappingId])
}

model CreatorDesign {
  id                           String                  @id @default(cuid())
  shop                         String
  creatorId                    String
  designSessionId              String                  @unique
  provider                     DesignProvider          @default(FABRIC)
  globalProductMappingId       String?
  globalShopifyProductId       String
  sourceZakekeDesignId         String?
  inkybaySavedDesignUrl        String?
  inkybayTid                   String?
  shopifyCreatorProductId      String?
  shopifyCollectionId          String?
  previewPoc                   Boolean                 @default(false)
  previewOwnerApp              String?
  title                        String
  slug                         String?
  description                  String?
  previewUrl                   String
  artworkUrl                   String
  productionArtworkKey         String?
  designJson                   String                  @db.Text
  compatibleVariantIdsJson     String                  @default("[]")
  selectedAttributesJson       String                  @default("[]")
  designVersion                Int                     @default(1)
  hiddenReason                 String?
  wasPublishedBeforeSuspension Boolean                 @default(false)
  status                       CreatorDesignStatus     @default(DRAFT)
  syncStatus                   CreatorDesignSyncStatus @default(PENDING)
  idempotencyKey               String
  publishError                 String?
  lastErrorCode                String?
  lastErrorReference           String?
  createdAt                    DateTime                @default(now())
  updatedAt                    DateTime                @updatedAt
  publishedAt                  DateTime?
  creator                      Creator                 @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  designSession                DesignSession           @relation(fields: [designSessionId], references: [id], onDelete: Restrict)
  globalProductMapping         GlobalProductMapping?   @relation(fields: [globalProductMappingId], references: [id], onDelete: SetNull)
  designPurchases              DesignPurchase[]

  @@unique([shop, idempotencyKey])
  @@unique([shop, slug])
  @@index([creatorId, status])
  @@index([shop, shopifyCreatorProductId])
  @@index([shop, syncStatus])
  @@index([shop, previewPoc])
  @@index([globalProductMappingId])
}

model GlobalProductMapping {
  id                   String                     @id @default(cuid())
  shop                 String
  shopifyProductId     String
  shopifyProductHandle String?
  zakekeProductCode    String
  enabled              Boolean                    @default(false)
  status               GlobalProductMappingStatus @default(DRAFT)
  variantMappingJson   String                     @default("{}")
  lastSyncedAt         DateTime?
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  designSessions       DesignSession[]
  creatorDesigns       CreatorDesign[]

  @@unique([shop, shopifyProductId])
  @@unique([shop, zakekeProductCode])
  @@index([shop, enabled, status])
}

model ProductionMethodSetting {
  id          String           @id @default(cuid())
  shopKey     String
  method      ProductionMethod
  label       String
  description String           @default("")
  enabled     Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([shopKey, method])
  @@index([shopKey, enabled])
}

model PublicProductProductionPricing {
  id                     String   @id @default(cuid())
  shopKey                String
  shopifyProductId       String
  embroiderySurcharge    Decimal  @default(0) @db.Decimal(10, 2)
  dtfSurcharge           Decimal  @default(0) @db.Decimal(10, 2)
  dtgSurcharge           Decimal  @default(0) @db.Decimal(10, 2)
  embroideryFeeVariantId String?
  dtfFeeVariantId        String?
  dtgFeeVariantId        String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@unique([shopKey, shopifyProductId])
  @@index([shopKey])
}

model DesignPurchase {
  id                     String               @id @default(cuid())
  shop                   String
  creatorDesignId        String?
  sourceZakekeDesignId   String
  purchaseZakekeDesignId String?
  shopifyProductId       String
  shopifyVariantId       String
  customerId             String?
  visitorCode            String?
  idempotencyKey         String
  signedTokenHash        String?
  status                 DesignPurchaseStatus @default(CREATING)
  expiresAt              DateTime
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  creatorDesign          CreatorDesign?       @relation(fields: [creatorDesignId], references: [id], onDelete: SetNull)

  @@unique([shop, idempotencyKey])
  @@index([creatorDesignId, status])
  @@index([shop, shopifyProductId, shopifyVariantId])
  @@index([shop, status, expiresAt])
}

model OrderDesignSnapshot {
  id                      String           @id @default(cuid())
  shop                    String
  shopifyOrderId          String
  shopifyLineItemId       String
  creatorId               String?
  creatorDesignId         String?
  sourceShopifyProductId  String
  shopifyCreatorProductId String?
  shopifyVariantId        String
  provider                DesignProvider   @default(ZAKEKE)
  sourceZakekeDesignId    String?
  orderZakekeDesignId     String?
  designVersion           Int
  previewUrl              String?
  productionArtworkKey    String?
  printFilesStatus        PrintFilesStatus @default(PENDING)
  printFilesReference     String?
  designTitle             String
  creatorName             String?
  createdAt               DateTime         @default(now())

  @@unique([shop, shopifyLineItemId])
  @@index([shop, shopifyOrderId])
  @@index([creatorDesignId])
  @@index([shop, printFilesStatus])
}

model CreatorSale {
  id                  String                  @id @default(cuid())
  shop                String
  creatorId           String
  creatorProductId    String?
  shopifyOrderId      String
  shopifyLineItemId   String
  shopifyProductId    String
  shopifyVariantId    String?
  productTitle        String
  quantity            Int
  refundedQuantity    Int                     @default(0)
  currencyCode        String
  grossSalesAmount    Decimal                 @db.Decimal(20, 4)
  refundedSalesAmount Decimal                 @default(0) @db.Decimal(20, 4)
  commissionRateBps   Int                     @default(1000)
  sourceWebhookId     String
  paidAt              DateTime?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  creator             Creator                 @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  adjustments         CreatorSaleAdjustment[]
  orderItem           CreatorOrderItem?
  referralEarning     ReferralEarning?

  @@unique([shop, shopifyLineItemId])
  @@index([creatorId, currencyCode, createdAt])
  @@index([creatorProductId])
  @@index([shop, shopifyOrderId])
  @@index([shop, shopifyProductId])
}

model CreatorOrderItem {
  id                          String                       @id @default(cuid())
  shop                        String
  shopifyOrderId              String
  shopifyOrderName            String?
  shopifyLineItemId           String
  creatorId                   String
  creatorProductId            String
  creatorSaleId               String?                      @unique
  creatorCollectionId         String?
  baseShopifyProductId        String
  baseShopifyVariantId        String?
  pitchprintProjectId         String?
  creatorProductTitleSnapshot String
  creatorNameSnapshot         String
  customerDisplayNameSnapshot String?
  variantTitleSnapshot        String?
  selectedOptionsJson         String                       @default("[]")
  quantity                    Int
  unitPrice                   Decimal                      @db.Decimal(20, 4)
  lineSubtotal                Decimal                      @db.Decimal(20, 4)
  currencyCode                String
  creatorPreviewUrl           String?
  productionStatus            CreatorOrderProductionStatus @default(NEW)
  productionNotes             String?
  readyAt                     DateTime?
  productionStartedAt         DateTime?
  fulfilledAt                 DateTime?
  cancelledAt                 DateTime?
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt
  creator                     Creator                      @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  creatorProduct              CreatorProduct               @relation(fields: [creatorProductId], references: [id], onDelete: Cascade)
  creatorSale                 CreatorSale?                 @relation(fields: [creatorSaleId], references: [id], onDelete: SetNull)

  @@unique([shop, shopifyOrderId, shopifyLineItemId, creatorProductId])
  @@index([shop, productionStatus, createdAt])
  @@index([shop, shopifyOrderId])
  @@index([shop, shopifyLineItemId])
  @@index([creatorId, productionStatus, createdAt])
  @@index([creatorProductId])
}

model CreatorSaleAdjustment {
  id                 String                     @id @default(cuid())
  shop               String
  adjustmentKey      String
  shopifyOrderId     String
  shopifyLineItemId  String
  creatorSaleId      String?
  quantity           Int
  salesAmount        Decimal                    @db.Decimal(20, 4)
  sourceWebhookId    String
  createdAt          DateTime                   @default(now())
  creatorSale        CreatorSale?               @relation(fields: [creatorSaleId], references: [id], onDelete: Cascade)
  referralAdjustment ReferralEarningAdjustment?

  @@unique([shop, adjustmentKey])
  @@index([shop, shopifyLineItemId])
  @@index([creatorSaleId])
}

model ReferralEarning {
  id                      String                      @id @default(cuid())
  shop                    String
  referrerCreatorId       String
  referredCreatorId       String
  creatorSaleId           String                      @unique
  shopifyOrderId          String
  shopifyLineItemId       String
  currencyCode            String
  baseCreatorEarningMinor BigInt
  rateBps                 Int
  amountMinor             BigInt
  status                  ReferralEarningStatus       @default(AVAILABLE)
  confirmedAt             DateTime?
  reversedAt              DateTime?
  createdAt               DateTime                    @default(now())
  updatedAt               DateTime                    @updatedAt
  referrerCreator         Creator                     @relation("ReferralEarningReferrer", fields: [referrerCreatorId], references: [id], onDelete: Cascade)
  referredCreator         Creator                     @relation("ReferralEarningReferred", fields: [referredCreatorId], references: [id], onDelete: Cascade)
  creatorSale             CreatorSale                 @relation(fields: [creatorSaleId], references: [id], onDelete: Cascade)
  adjustments             ReferralEarningAdjustment[]

  @@unique([shop, creatorSaleId])
  @@index([shop, referrerCreatorId, status])
  @@index([shop, referredCreatorId])
  @@index([shop, currencyCode, status])
}

model ReferralEarningAdjustment {
  id                      String                @id @default(cuid())
  shop                    String
  referralEarningId       String
  creatorSaleAdjustmentId String                @unique
  adjustmentKey           String
  baseAdjustmentMinor     BigInt
  referralAdjustmentMinor BigInt
  reason                  String                @default("REFUND")
  createdAt               DateTime              @default(now())
  referralEarning         ReferralEarning       @relation(fields: [referralEarningId], references: [id], onDelete: Cascade)
  creatorSaleAdjustment   CreatorSaleAdjustment @relation(fields: [creatorSaleAdjustmentId], references: [id], onDelete: Cascade)

  @@unique([shop, creatorSaleAdjustmentId])
  @@unique([shop, adjustmentKey])
  @@index([shop, referralEarningId])
}

model ReferralAttribution {
  id                   String                    @id @default(cuid())
  shop                 String
  shopifyCustomerId    String
  referrerCreatorId    String
  referralCodeSnapshot String
  status               ReferralAttributionStatus @default(CAPTURED)
  capturedAt           DateTime                  @default(now())
  convertedAt          DateTime?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  referrerCreator      Creator                   @relation("ReferralReferrer", fields: [referrerCreatorId], references: [id], onDelete: Cascade)

  @@unique([shop, shopifyCustomerId])
  @@index([shop, status])
  @@index([referrerCreatorId])
}

model PayoutMethod {
  id                  String             @id @default(cuid())
  shop                String
  creatorId           String
  type                PayoutMethodType
  status              PayoutMethodStatus @default(PENDING_VERIFICATION)
  isDefault           Boolean            @default(false)
  displayLabel        String
  encryptedDetails    String             @db.Text
  externalRecipientId String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  creator             Creator            @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  payouts             Payout[]

  @@index([shop, creatorId, status])
  @@index([shop, creatorId, isDefault])
}

model Payout {
  id                      String              @id @default(cuid())
  shop                    String
  creatorId               String
  payoutMethodId          String?
  methodTypeSnapshot      PayoutMethodType
  methodDisplaySnapshot   String
  encryptedMethodSnapshot String              @db.Text
  executionMode           PayoutExecutionMode @default(MANUAL)
  currency                String
  requestedAmountMinor    BigInt
  feeMinor                BigInt              @default(0)
  netAmountMinor          BigInt
  status                  PayoutStatus        @default(REQUESTED)
  requestedAt             DateTime            @default(now())
  approvedAt              DateTime?
  processingAt            DateTime?
  paidAt                  DateTime?
  rejectedAt              DateTime?
  cancelledAt             DateTime?
  failedAt                DateTime?
  transactionReference    String?
  creatorNote             String?
  adminNote               String?
  rejectionReason         String?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
  creator                 Creator             @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  payoutMethod            PayoutMethod?       @relation(fields: [payoutMethodId], references: [id], onDelete: SetNull)
  allocations             PayoutAllocation[]

  @@index([shop, creatorId, status])
  @@index([shop, status, requestedAt])
  @@index([shop, currency, status])
}

model PayoutAllocation {
  id          String                     @id @default(cuid())
  shop        String
  payoutId    String
  sourceType  PayoutAllocationSourceType
  sourceId    String
  currency    String
  amountMinor BigInt
  createdAt   DateTime                   @default(now())
  payout      Payout                     @relation(fields: [payoutId], references: [id], onDelete: Cascade)

  @@index([shop, sourceType, sourceId])
  @@index([shop, payoutId])
}

model WebhookDelivery {
  id            String                @id @default(cuid())
  shop          String
  webhookId     String
  topic         String
  status        WebhookDeliveryStatus @default(PROCESSING)
  attempts      Int                   @default(1)
  lastErrorCode String?
  lastReference String?
  processedAt   DateTime?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@unique([shop, webhookId])
  @@index([shop, topic, status])
}

model ZakekeOrderJob {
  id                 String               @id @default(cuid())
  shop               String
  shopifyOrderId     String
  shopifyOrderCode   String
  customerId         String?
  visitorCode        String?
  payloadJson        String               @db.Text
  status             ZakekeOrderJobStatus @default(PENDING)
  attempts           Int                  @default(0)
  nextAttemptAt      DateTime?
  lastErrorCode      String?
  lastErrorReference String?
  registeredAt       DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@unique([shop, shopifyOrderId])
  @@index([shop, status, nextAttemptAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  shop       String
  actorType  String
  actorId    String?
  action     String
  entityType String
  entityId   String
  beforeJson String?
  afterJson  String?
  createdAt  DateTime @default(now())

  @@index([shop, createdAt])
  @@index([entityType, entityId])
}

model AdminNotification {
  id           String    @id @default(cuid())
  shop         String
  type         String
  title        String
  message      String
  entityType   String
  entityId     String
  actionUrl    String?
  metadataJson String    @default("{}")
  readAt       DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([shop, readAt, createdAt])
  @@index([shop, entityType, entityId])
}
