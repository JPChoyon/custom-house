{% if product.metafields.customhouse.product_origin.value == 'global' and product.metafields.customhouse.design_mode.value == 'customizable' %}{{ 'customhouse.css' | asset_url | stylesheet_tag }}<section class="customhouse-card" data-customhouse data-customhouse-submission data-product-gid="{{ product.id | prepend: 'gid://shopify/Product/' }}"><h2>{{ block.settings.heading }}</h2><p data-status>Checking creator access…</p><form hidden><label class="customhouse-field">Design name<input name="designName" required maxlength="100"></label><label class="customhouse-field">PitchPrint saved-design URL<input name="savedDesignUrl" type="url" required pattern="https://.*"></label><label class="customhouse-field">Preview URL (optional)<input name="previewUrl" type="url" pattern="https://.*"></label><label class="customhouse-field">Message (optional)<textarea name="creatorMessage" maxlength="1000"></textarea></label><button type="submit">Submit to My Collection</button></form></section><script src="{{ 'customhouse.js' | asset_url }}" defer></script>{% endif %}
{% schema %}{"name":"Creator Submission","target":"section","settings":[{"type":"text","id":"heading","label":"Heading","default":"Submit this design"}]}{% endschema %}
