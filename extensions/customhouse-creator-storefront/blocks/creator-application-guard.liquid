{% assign protected_handle = block.settings.page_handle | default: 'become-a-creator' | strip %}
{% assign creator_dashboard_url = block.settings.dashboard_url | default: '/pages/creator-dashboard' %}
{% assign application_return_to = request.path | default: '/pages/become-a-creator' | url_encode %}
{% assign creator_application_login_url = '/customer_authentication/login?return_to=' | append: application_return_to %}

{% if request.page_type == 'page' and page.handle == protected_handle %}
  {{ 'creator-application.css' | asset_url | stylesheet_tag }}
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20,500,0,0">

  <style>
    main > :not(.ch-application):not(:has(.ch-application)),
    #MainContent > :not(.ch-application):not(:has(.ch-application)) {
      display: none !important;
    }
  </style>

  <section
    class="ch-application"
    data-customhouse-creator-application
    data-endpoint="/apps/customhouse/api/creator-application"
    data-submit-endpoint="/apps/customhouse/api/applications"
    data-dashboard-url="{{ creator_dashboard_url | escape }}"
    data-login-url="{{ creator_application_login_url | escape }}"
  >
    <div class="ch-application__shell">
      <header class="ch-application__header" data-application-header>
        <h1><span>Creator</span> Application</h1>
        <p>Loading your creator workspace...</p>
      </header>

      <div class="ch-application__grid">
        <div class="ch-application__card" data-application-screen>
          <div class="ch-application__loading">
            <span></span>
            <strong>Loading application status...</strong>
            <p>Preparing your Custom House creator application.</p>
          </div>
        </div>

        <aside class="ch-application__side" data-application-side aria-label="Creator benefits">
          <section class="ch-application__side-card">
            <h2>Creator workspace</h2>
            <ul>
              <li>Approved creators receive a private dashboard.</li>
              <li>Your designs stay connected to your own creator collection.</li>
              <li>Sales, commission, orders, and payouts remain tracked in Custom House.</li>
            </ul>
          </section>
        </aside>
      </div>
    </div>
  </section>

  <script type="module" src="{{ 'creator-application.js' | asset_url }}"></script>
{% endif %}

{% schema %}
{
  "name": "Creator application guard",
  "target": "body",
  "settings": [
    {
      "type": "text",
      "id": "page_handle",
      "label": "Creator application page handle",
      "default": "become-a-creator"
    },
    {
      "type": "url",
      "id": "dashboard_url",
      "label": "Creator dashboard page"
    }
  ]
}
{% endschema %}
