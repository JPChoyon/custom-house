{{ 'customhouse.css' | asset_url | stylesheet_tag }}
<section class="customhouse-card" data-customhouse data-customhouse-application data-dashboard-url="{{ block.settings.dashboard_url | default: '/pages/creator-dashboard' }}">
  <h2>{{ block.settings.heading }}</h2>
  <p data-application-loading role="status">Loading…</p>
  <div data-application-message aria-live="polite" hidden></div>
  <p><a data-application-login href="{{ routes.account_login_url }}" hidden>Sign in to apply</a></p>
  <form data-application-form hidden novalidate>
    <label class="customhouse-field">Legal name<input name="legalName" required minlength="2" maxlength="120" autocomplete="name"></label>
    <label class="customhouse-field">Creator display name<input name="displayName" required minlength="2" maxlength="80"></label>
    <label class="customhouse-field">Country<input name="country" required minlength="2" maxlength="80" autocomplete="country-name"></label>
    <label class="customhouse-field">City<input name="city" required maxlength="100" autocomplete="address-level2"></label>
    <label class="customhouse-field">Profile image<input name="profileImage" type="file" accept="image/jpeg,image/png,image/webp"></label>
    <label class="customhouse-field">Short biography<textarea name="bio" required minlength="10" maxlength="1000"></textarea></label>
    <label class="customhouse-field">Portfolio or social URL<input name="portfolioUrl" type="url" pattern="https://.*"></label>
    <label class="customhouse-field">Additional social links (one HTTPS URL per line)<textarea name="socialLinks" maxlength="1500"></textarea></label>
    <label class="customhouse-field">Message to the admin<textarea name="message" maxlength="1000"></textarea></label>
    <label><input name="termsAccepted" type="checkbox" required> I accept the creator terms.</label>
    <button type="submit">{{ block.settings.button }}</button>
  </form>
  <p><a data-application-dashboard href="{{ block.settings.dashboard_url | default: '/pages/creator-dashboard' }}" hidden>Open Creator Dashboard</a></p>
</section>
<script src="{{ 'customhouse.js' | asset_url }}" defer></script>
{% schema %}
{"name":"Creator Application","target":"section","settings":[{"type":"text","id":"heading","label":"Heading","default":"Become a Creator"},{"type":"text","id":"button","label":"Button","default":"Submit application"},{"type":"url","id":"dashboard_url","label":"Creator Dashboard page"}]}
{% endschema %}
