{{ 'customhouse.css' | asset_url | stylesheet_tag }}
<section class="customhouse-card" data-customhouse data-customhouse-application><h2>{{ block.settings.heading }}</h2><p data-status>Loading…</p><form hidden><label class="customhouse-field">Display name<input name="displayName" required maxlength="80"></label><label class="customhouse-field">Short biography<textarea name="bio" required minlength="10" maxlength="1000"></textarea></label><label class="customhouse-field">Portfolio URL<input name="portfolioUrl" type="url" pattern="https://.*"></label><label class="customhouse-field">Profile image URL<input name="profileImageUrl" type="url" pattern="https://.*"></label><label><input name="confirmed" type="checkbox" value="true" required> I confirm this application is accurate.</label><button type="submit">{{ block.settings.button }}</button></form></section>
<script src="{{ 'customhouse.js' | asset_url }}" defer></script>
{% schema %}{"name":"Creator Application","target":"section","settings":[{"type":"text","id":"heading","label":"Heading","default":"Become a Creator"},{"type":"text","id":"button","label":"Button","default":"Submit application"}]}{% endschema %}
