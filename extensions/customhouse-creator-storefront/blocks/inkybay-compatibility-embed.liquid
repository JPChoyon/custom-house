{% liquid
  assign product_origin = product.metafields.customhouse.product_origin.value | downcase
  assign design_mode = product.metafields.customhouse.design_mode.value | downcase
  assign design_status = product.metafields.customhouse.design_status.value | downcase
  assign is_creator_locked_product = false
  if product_origin == 'creator' and design_mode == 'buy_only' and design_status == 'published'
    assign is_creator_locked_product = true
  endif
%}
{% if is_creator_locked_product %}<span data-customhouse data-customhouse-buy-only data-customhouse-product-mode="creator-locked" data-selectors="{{ block.settings.selectors | escape }}" hidden></span><script src="{{ 'customhouse.js' | asset_url }}" defer></script>{% endif %}
{% schema %}{"name":"PitchPrint Compatibility","target":"body","settings":[{"type":"textarea","id":"selectors","label":"Selector JSON","default":"[]","info":"Copy the validated selector JSON from app Settings. Default hides nothing."}]}{% endschema %}
