{% if product.metafields.customhouse.product_origin.value == 'creator' and product.metafields.customhouse.design_mode.value == 'buy_only' %}<span data-customhouse data-customhouse-buy-only data-selectors="{{ block.settings.selectors | escape }}" hidden></span><script src="{{ 'customhouse.js' | asset_url }}" defer></script>{% endif %}
{% schema %}{"name":"InkyBay Compatibility","target":"body","settings":[{"type":"textarea","id":"selectors","label":"Selector JSON","default":"[]","info":"Copy the validated selector JSON from app Settings. Default hides nothing."}]}{% endschema %}
