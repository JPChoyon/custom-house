{{ 'customhouse.css' | asset_url | stylesheet_tag }}
{% assign helium_legal_name = customer.metafields["app--960624--helium"]["legal_name"].value | default: customer.metafields["app--960624--helium"]["creator_legal_name"].value %}
{% assign helium_display_name = customer.metafields["app--960624--helium"]["creator_display_name_1"].value | default: customer.metafields["app--960624--helium"]["creator_display_name"].value %}
{% assign helium_bio = customer.metafields["app--960624--helium"]["short_creator_bio"].value | default: customer.metafields["app--960624--helium"]["creator_bio"].value %}
{% assign helium_portfolio = customer.metafields["app--960624--helium"]["socialportfolio_url"].value %}
{% assign helium_profile = customer.metafields["app--960624--helium"]["creator_profile_photo_1"].value | default: customer.metafields["app--960624--helium"]["creator_profile_photo"].value %}
{% assign helium_profile_url = helium_profile.url | default: helium_profile.preview_image.src %}
<section
  class="customhouse-card"
  data-customhouse-dashboard
  data-helium-legal-name="{{ helium_legal_name | escape }}"
  data-helium-display-name="{{ helium_display_name | escape }}"
  data-helium-bio="{{ helium_bio | escape }}"
  data-helium-portfolio="{{ helium_portfolio | escape }}"
  data-helium-profile-image="{{ helium_profile_url | escape }}"
>
  <h2>{{ block.settings.heading }}</h2>
  <p data-dashboard-loading role="status">Loading…</p>
  <p data-dashboard-message aria-live="polite" hidden></p>
  <p><a data-dashboard-login href="{{ routes.account_login_url }}" hidden>Customer login</a></p>
  <p><a data-dashboard-apply href="{{ block.settings.application_url | default: '/pages/become-a-creator' }}" hidden>Become a Creator</a></p>
  <div data-dashboard-profile hidden>
    <img class="customhouse-dashboard-avatar" data-dashboard-image alt="" hidden width="96" height="96">
    <p><strong data-dashboard-name></strong> — <span data-dashboard-status></span></p>
    <form data-dashboard-image-form>
      <label class="customhouse-field">
        Profile picture
        <input data-dashboard-image-input type="file" name="profileImage" accept="image/jpeg,image/png,image/webp">
      </label>
      <button type="submit">Upload profile picture</button>
      <span data-dashboard-image-message role="status"></span>
    </form>
    <div class="customhouse-dashboard-grid" aria-label="Creator overview">
      <article class="customhouse-dashboard-stat">
        <span>Total sales</span>
        <strong data-dashboard-total-sales>Not configured</strong>
      </article>
      <article class="customhouse-dashboard-stat">
        <span>Total earnings</span>
        <strong data-dashboard-total-earnings>Not configured</strong>
      </article>
      <article class="customhouse-dashboard-stat">
        <span>Orders</span>
        <strong data-dashboard-orders>Not configured</strong>
      </article>
      <article class="customhouse-dashboard-stat">
        <span>Collections</span>
        <strong data-dashboard-collections>0</strong>
      </article>
      <article class="customhouse-dashboard-stat">
        <span>Published products</span>
        <strong data-dashboard-products>0</strong>
      </article>
    </div>
    <p data-dashboard-bio></p>
    <p><a data-dashboard-portfolio hidden>Creator portfolio</a></p>
    <p><a data-dashboard-collection href="{{ routes.root_url }}" hidden>View creator collection</a></p>
    <section>
      <h3>Top selling products</h3>
      <p data-dashboard-top-products-empty>
        Sales tracking is not configured yet.
      </p>
      <ol data-dashboard-top-products></ol>
    </section>
    <h3>Recent submissions</h3>
    <ul data-dashboard-submissions></ul>
  </div>
</section>
<script type="module" src="{{ 'customhouse-dashboard.js' | asset_url }}"></script>
{% schema %}
{
  "name": "Creator Dashboard",
  "target": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "My Creator Dashboard" },
    { "type": "url", "id": "application_url", "label": "Become a Creator page" }
  ]
}
{% endschema %}
