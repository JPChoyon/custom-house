<script>
  (() => {
    const root = document.getElementById('header-component');
    const drawer = document.getElementById('CustomhouseMobileDrawer-{{ section.id }}');
    if (!root || !drawer || drawer.dataset.customhouseReady === 'true') return;

    const openButton = root.querySelector('[data-customhouse-menu-open]');
    const closeButtons = root.querySelectorAll('[data-customhouse-menu-close]');
    const overlay = root.querySelector('.customhouse-mobile-drawer__overlay');
    const profileMenu = root.querySelector('.customhouse-header__profile');
    if (!openButton || !overlay) return;

    drawer.dataset.customhouseReady = 'true';
    const drawerQuery = window.matchMedia('(max-width: 1180px)');
    let closeTimer;

    const openDrawer = () => {
      if (!drawerQuery.matches) return;
      clearTimeout(closeTimer);
      drawer.hidden = false;
      overlay.hidden = false;
      drawer.setAttribute('aria-hidden', 'false');
      openButton.setAttribute('aria-expanded', 'true');
      document.documentElement.classList.add('customhouse-mobile-drawer-open');
      requestAnimationFrame(() => {
        drawer.classList.add('is-open');
        overlay.classList.add('is-open');
        drawer.focus({ preventScroll: true });
      });
    };

    const closeDrawer = () => {
      drawer.classList.remove('is-open');
      overlay.classList.remove('is-open');
      drawer.setAttribute('aria-hidden', 'true');
      openButton.setAttribute('aria-expanded', 'false');
      document.documentElement.classList.remove('customhouse-mobile-drawer-open');
      closeTimer = setTimeout(() => {
        drawer.hidden = true;
        overlay.hidden = true;
      }, 280);
    };

    openButton.addEventListener('click', openDrawer);
    closeButtons.forEach((button) => button.addEventListener('click', closeDrawer));
    const closeProfileMenu = () => {
      if (profileMenu?.open) profileMenu.open = false;
    };

    document.addEventListener('pointerdown', (event) => {
      if (profileMenu?.open && !profileMenu.contains(event.target)) {
        closeProfileMenu();
      }
    });
    document.addEventListener('click', (event) => {
      if (profileMenu?.open && event.target.closest('a')) {
        closeProfileMenu();
      }
    });
    window.addEventListener('scroll', closeProfileMenu, { passive: true });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') closeProfileMenu();
      if (event.key === 'Escape' && drawer.classList.contains('is-open')) closeDrawer();
    });

    const handleDrawerBreakpoint = (event) => {
      if (!event.matches && drawer.classList.contains('is-open')) closeDrawer();
    };

    if (drawerQuery.addEventListener) {
      drawerQuery.addEventListener('change', handleDrawerBreakpoint);
    } else {
      drawerQuery.addListener(handleDrawerBreakpoint);
    }
  })();
</script>

